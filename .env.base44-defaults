# Base44 dev defaults — placeholders so the app boots without real secrets.
# Real secrets in /run/base44/app.env override these (last env_file wins).

# Auth is disabled in dev — site is fully public (no login gate).
AUTH_ENABLED=false

# Express auth server (only used when AUTH_ENABLED=true).
WEBSITE_DOMAIN=http://localhost:3000
API_DOMAIN=http://localhost:3000
PORT=3001

# SuperTokens demo core — local tryout only; not production-safe.
SUPERTOKENS_CONNECTION_URI=https://try.supertokens.com

# Friends-and-family invite code (only used when AUTH_ENABLED=true).
INVITE_CODE=belgium420-ff
