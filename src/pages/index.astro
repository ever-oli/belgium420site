  <script>
    import { initCart } from "../scripts/cart-ui.ts";
    initCart();
  </script>
  <script is:inline>
    (function () {
      var nav = document.getElementById('siteNav');
      var toggle = document.getElementById('navToggle');
      var links = document.getElementById('navLinks');

      function closeMenu() {
        if (!toggle || !links) return;
        toggle.classList.remove('is-open');
        links.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        document.body.classList.remove('nav-open');
      }

      if (toggle && links) {
        toggle.addEventListener('click', function () {
          var open = links.classList.toggle('is-open');
          toggle.classList.toggle('is-open', open);
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          document.body.classList.toggle('nav-open', open);
          if (open && nav) nav.classList.add('is-solid');
        });
        links.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', closeMenu);
        });
        window.addEventListener('resize', function () {
          if (window.innerWidth > 900) closeMenu();
        });
      }

      if (nav) {
        var onScroll = function () {
          if (window.scrollY > 40 || document.body.classList.contains('nav-open')) {
            nav.classList.add('is-solid');
          } else {
            nav.classList.remove('is-solid');
          }
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      var grid  = document.getElementById('productGrid');
      var empty = document.getElementById('catEmpty');
      var shop = document.getElementById('shop');
      var shopFilters = document.getElementById('shopFilters');
      var dock = document.getElementById('shopCatDock');
      var filterWrap = document.getElementById('shopFilterWrap');
      var filterFab = document.getElementById('shopFilterFab');
      var filterBadge = document.getElementById('shopFilterBadge');
      var scrollPill = document.getElementById('scrollPill');
      var scrollPillBtn = document.getElementById('scrollPillBtn');
      if (!grid) return;

      var cards = Array.prototype.slice.call(grid.querySelectorAll('.product-card'));
      var cardMeta = cards.map(function (card) {
        return {
          tags: (card.getAttribute('data-cats') || '').split(/\s+/).filter(Boolean),
          vibes: (card.getAttribute('data-vibes') || '').split(/\s+/).filter(Boolean),
          strainType: card.getAttribute('data-type') || '',
        };
      });
      var activeCat = 'all';
      var activeEffect = 'all';
      var activeType = 'all';

      function matchesMeta(meta, cat, effect, type) {
        var catOk = cat === 'all' || meta.tags.indexOf(cat) !== -1;
        var effectOk = effect === 'all' || meta.vibes.indexOf(effect) !== -1;
        var typeOk = type === 'all' || meta.strainType === type;
        return catOk && effectOk && typeOk;
      }

      function countCards(cat, effect, type) {
        var n = 0;
        for (var i = 0; i < cardMeta.length; i++) {
          if (matchesMeta(cardMeta[i], cat, effect, type)) n++;
        }
        return n;
      }

      function applyFilter() {
        var visible = 0;
        cards.forEach(function (card, i) {
          var show = matchesMeta(cardMeta[i], activeCat, activeEffect, activeType);
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        if (empty) empty.hidden = visible !== 0;
      }

      function syncChips(sel, attr, id) {
        document.querySelectorAll(sel).forEach(function (chip) {
          var on = (chip.getAttribute(attr) || '') === id;
          chip.classList.toggle('is-active', on);
          chip.setAttribute('aria-selected', on ? 'true' : 'false');
        });
      }

      function setChipVisible(chip, open, count) {
        chip.hidden = !open;
        chip.classList.toggle('is-empty', !open);
        chip.setAttribute('aria-hidden', open ? 'false' : 'true');
        var countEl = chip.querySelector('.cat-chip-count, .effect-chip-count, .type-chip-count');
        if (countEl) countEl.textContent = String(count);
      }

      function updateChipAvailability() {
        document.querySelectorAll('.cat-chip').forEach(function (chip) {
          var id = chip.getAttribute('data-cat') || 'all';
          var n = countCards(id, activeEffect, activeType);
          setChipVisible(chip, id === 'all' || n > 0, n);
        });
        document.querySelectorAll('.effect-chip').forEach(function (chip) {
          var id = chip.getAttribute('data-effect') || 'all';
          var n = countCards(activeCat, id, activeType);
          setChipVisible(chip, id === 'all' || n > 0, n);
        });
        document.querySelectorAll('.type-chip').forEach(function (chip) {
          var id = chip.getAttribute('data-type') || 'all';
          var n = countCards(activeCat, activeEffect, id);
          setChipVisible(chip, id === 'all' || n > 0, n);
        });
      }

      function updateFilterBadge() {
        if (!filterBadge) return;
        var n = (activeCat !== 'all' ? 1 : 0) + (activeEffect !== 'all' ? 1 : 0) + (activeType !== 'all' ? 1 : 0);
        filterBadge.textContent = String(n);
        filterBadge.hidden = n === 0;
      }

      function setFilter(dim, id) {
        if (dim === 'cat') activeCat = id || 'all';
        if (dim === 'effect') activeEffect = id || 'all';
        if (dim === 'type') activeType = id || 'all';
        if (dim === 'cat') syncChips('.cat-chip', 'data-cat', activeCat);
        if (dim === 'effect') syncChips('.effect-chip', 'data-effect', activeEffect);
        if (dim === 'type') syncChips('.type-chip', 'data-type', activeType);
        applyFilter();
        updateChipAvailability();
        updateFilterBadge();
      }

      function setFilterSheetOpen(open) {
        if (!filterWrap || !filterFab) return;
        filterWrap.classList.toggle('is-open', open);
        filterFab.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open && scrollPill && scrollPillBtn) {
          scrollPill.classList.remove('is-open');
          scrollPillBtn.setAttribute('aria-expanded', 'false');
        }
      }

      function navHeight() {
        return window.innerWidth > 900 ? 64 : 60;
      }

      function updateShopChrome() {
        if (!dock || !filterWrap || !shop || !shopFilters) return;
        var navH = navHeight();
        var shopRect = shop.getBoundingClientRect();
        var filtersRect = shopFilters.getBoundingClientRect();
        var shopVisible = shopRect.bottom > navH && shopRect.top < window.innerHeight;
        var chipsPast = filtersRect.bottom < navH + 4;
        var show = shopVisible && chipsPast;
        dock.classList.toggle('is-visible', show);
        dock.setAttribute('aria-hidden', show ? 'false' : 'true');
        filterWrap.classList.toggle('is-visible', show);
        filterWrap.setAttribute('aria-hidden', show ? 'false' : 'true');
        if (!show) setFilterSheetOpen(false);
      }

      document.querySelectorAll('.cat-chip').forEach(function (chip) {
        chip.addEventListener('click', function () {
          if (chip.hidden) return;
          setFilter('cat', chip.getAttribute('data-cat') || 'all');
        });
      });
      document.querySelectorAll('.effect-chip').forEach(function (chip) {
        chip.addEventListener('click', function () {
          if (chip.hidden) return;
          setFilter('effect', chip.getAttribute('data-effect') || 'all');
        });
      });
      document.querySelectorAll('.type-chip').forEach(function (chip) {
        chip.addEventListener('click', function () {
          if (chip.hidden) return;
          setFilter('type', chip.getAttribute('data-type') || 'all');
        });
      });

      updateChipAvailability();

      if (filterFab && filterWrap) {
        filterFab.addEventListener('click', function (e) {
          e.stopPropagation();
          setFilterSheetOpen(!filterWrap.classList.contains('is-open'));
        });
        var sheet = document.getElementById('shopFilterSheet');
        if (sheet) {
          sheet.addEventListener('click', function (e) { e.stopPropagation(); });
        }
        document.addEventListener('click', function () { setFilterSheetOpen(false); });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') setFilterSheetOpen(false);
        });
      }

      if (shop && shopFilters) {
        if (typeof IntersectionObserver === 'function') {
          var io = new IntersectionObserver(updateShopChrome, {
            rootMargin: '-64px 0px 0px 0px',
            threshold: [0, 0.01, 1]
          });
          io.observe(shop);
          io.observe(shopFilters);
        }
        window.addEventListener('scroll', updateShopChrome, { passive: true });
        window.addEventListener('resize', updateShopChrome);
        updateShopChrome();
      }
    })();

    // Age gate (works whether or not the auth gate is enabled).
    (function () {
      var ageGate = document.getElementById('ageGate');
      if (!ageGate) return;
      var yes = document.querySelector('.age-btn-yes');
      var no = document.querySelector('.age-btn-no');
      function hide() {
        ageGate.classList.add('hidden');
        try { sessionStorage.setItem('ageVerified', 'true'); } catch (e) {}
      }
      try {
        if (sessionStorage.getItem('ageVerified') === 'true') hide();
      } catch (e) {}
      if (yes) yes.addEventListener('click', hide);
      if (no) no.addEventListener('click', function () {
        window.location.href = 'https://www.google.com';
      });
    })();

    (function () {
      var sections = [
        { id: 'top', label: 'Home' },
        { id: 'shop', label: 'Shop' },
        { id: 'lab', label: 'Lab' },
        { id: 'shipping', label: 'Shipping' },
        { id: 'about', label: 'About' }
      ];
      var bar = document.getElementById('scrollRailBar');
      var ring = document.getElementById('scrollRingArc');
      var label = document.getElementById('scrollPillLabel');
      var pill = document.getElementById('scrollPill');
      var btn = document.getElementById('scrollPillBtn');
      var list = document.getElementById('scrollPillList');
      var RING = 62.832;
      if (!bar || !ring || !label || !pill || !btn || !list) return;

      function progress() {
        var max = document.documentElement.scrollHeight - window.innerHeight;
        if (max <= 0) return 0;
        return Math.min(1, Math.max(0, window.scrollY / max));
      }

      function currentSection() {
        var y = window.scrollY + window.innerHeight * 0.28;
        var current = sections[0];
        for (var i = 0; i < sections.length; i++) {
          var el = document.getElementById(sections[i].id);
          if (el && el.offsetTop <= y) current = sections[i];
        }
        return current;
      }

      function update() {
        var p = progress();
        bar.style.width = (p * 100) + '%';
        ring.setAttribute('stroke-dashoffset', String(RING * (1 - p)));
        var cur = currentSection();
        label.textContent = cur.label;
        var links = list.querySelectorAll('a');
        for (var i = 0; i < links.length; i++) {
          var href = links[i].getAttribute('href') || '';
          links[i].classList.toggle('is-current', href === '#' + cur.id);
        }
      }

      function setOpen(open) {
        pill.classList.toggle('is-open', open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      }

      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var opening = !pill.classList.contains('is-open');
        setOpen(opening);
        if (opening) {
          var filterWrap = document.getElementById('shopFilterWrap');
          var filterFab = document.getElementById('shopFilterFab');
          if (filterWrap) filterWrap.classList.remove('is-open');
          if (filterFab) filterFab.setAttribute('aria-expanded', 'false');
        }
      });
      document.addEventListener('click', function () { setOpen(false); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') setOpen(false);
      });
      list.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () { setOpen(false); });
      });

      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
    })();
  </script>
