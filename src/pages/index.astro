  <style>
    :root {
      --belgian-black: #050505;
      --belgian-yellow: #F5C400;
      --belgian-red: #E31C23;
      --asphalt: #141414;
      --concrete: #9A968C;
      --chalk: #F5F1E8;
      --ink: #050505;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 72px; }
    body {
      font-family: 'Space Grotesk', system-ui, sans-serif;
      background: var(--belgian-black);
      color: var(--chalk);
      line-height: 1.6;
      overflow-x: hidden;
    }

    body::after {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 9998;
      pointer-events: none;
      opacity: 0.045;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      background-repeat: repeat;
    }

    /* ============ SMOKEY SHADER BACKGROUND ============ */
    #smokeBg {
      position: fixed;
      inset: 0;
      z-index: -1;            /* behind everything, above body bg */
      pointer-events: none;
      background: var(--belgian-black);
      opacity: 0.92;          /* near-solid smoke; the grunge picture floats faintly over it */
    }

    /* ============ AGE GATE ============ */
    .age-gate {
      position: fixed;
      inset: 0;
      z-index: 10000;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 2rem;
      transition: opacity 0.55s ease, visibility 0.55s ease;
      overflow: hidden;
    }
    .age-gate-bg {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, rgba(5,5,5,0.72) 0%, rgba(5,5,5,0.88) 100%),
        url('/brand/belgium-flag-grunge.jpg') center / cover no-repeat;
      transform: scale(1.04);
    }
    .age-gate.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .age-gate-inner {
      position: relative;
      z-index: 1;
      text-align: center;
      max-width: 440px;
    }
    .age-gate-brand {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.85rem;
      margin-bottom: 1.5rem;
    }
    .age-gate-brand .brand-logo-flag {
      width: 96px;
      height: 64px;
    }
    .age-gate-brand .brand-logo-420 {
      font-size: 1.55rem;
    }
    .age-gate-brand .brand-logo-word {
      font-size: clamp(1.5rem, 4vw, 2rem);
    }
    .age-gate h2 {
      font-family: 'Anton', sans-serif;
      font-size: clamp(1.6rem, 4.5vw, 2.25rem);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--chalk);
      margin-bottom: 0.75rem;
      line-height: 1.1;
    }
    .age-gate p {
      color: rgba(245, 241, 232, 0.78);
      margin-bottom: 2rem;
      font-size: 0.95rem;
    }
    .age-gate-buttons {
      display: flex;
      gap: 0.75rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    .age-btn {
      padding: 0.9rem 2.25rem;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      cursor: pointer;
      border: none;
      transition: transform 0.2s, background 0.2s, color 0.2s, border-color 0.2s;
    }
    .age-btn-yes {
      background: var(--belgian-yellow);
      color: var(--ink);
    }
    .age-btn-yes:hover {
      background: var(--chalk);
      transform: translateY(-2px);
    }
    .age-btn-no {
      background: transparent;
      color: var(--chalk);
      border: 1px solid rgba(245, 241, 232, 0.25);
    }
    .age-btn-no:hover {
      border-color: var(--belgian-red);
      color: var(--belgian-red);
    }
    .age-gate-legal {
      margin-top: 2rem;
      font-size: 0.7rem;
      color: var(--concrete);
    }

    /* ============ AUTH GATE (SuperTokens) ============ */
    .auth-gate {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 2rem;
      transition: opacity 0.45s ease, visibility 0.45s ease;
      overflow: auto;
    }
    .auth-gate-bg {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, rgba(5,5,5,0.82) 0%, rgba(5,5,5,0.94) 100%),
        url('/brand/belgium-flag-grunge.jpg') center / cover no-repeat;
    }
    .auth-gate.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .auth-gate-inner {
      position: relative;
      z-index: 1;
      width: min(100%, 420px);
      text-align: center;
    }
    .auth-gate h2 {
      font-family: 'Anton', sans-serif;
      font-size: clamp(1.5rem, 4vw, 2rem);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin: 0 0 0.5rem;
    }
    .auth-gate .auth-lead {
      color: rgba(245, 241, 232, 0.78);
      font-size: 0.92rem;
      margin-bottom: 1.5rem;
    }
    .stripe-challenge {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.65rem;
      margin-bottom: 0.85rem;
    }
    .stripe-btn {
      height: 64px;
      border: 2px solid transparent;
      cursor: pointer;
      transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .stripe-btn[data-stripe="black"] { background: #111; color: var(--chalk); }
    .stripe-btn[data-stripe="yellow"] { background: var(--belgian-yellow); color: var(--ink); }
    .stripe-btn[data-stripe="red"] { background: var(--belgian-red); color: var(--chalk); }
    .stripe-btn:hover { transform: translateY(-2px); }
    .stripe-btn.is-hit {
      border-color: var(--chalk);
      box-shadow: 0 0 0 2px rgba(245,241,232,0.25);
    }
    #challengeStatus {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: var(--concrete);
      margin-bottom: 1.25rem;
      min-height: 1.1em;
    }
    .auth-form {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      text-align: left;
    }
    .auth-form label {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--concrete);
    }
    .auth-form input {
      padding: 0.85rem 0.9rem;
      border: 1px solid rgba(245,241,232,0.18);
      background: rgba(5,5,5,0.65);
      color: var(--chalk);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.95rem;
    }
    .auth-form input:focus {
      outline: none;
      border-color: var(--belgian-yellow);
    }
    .auth-submit {
      margin-top: 0.35rem;
      padding: 0.95rem 1.25rem;
      border: none;
      background: var(--belgian-yellow);
      color: var(--ink);
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 0.85rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
    }
    .auth-submit:hover { background: var(--chalk); }
    .auth-submit:disabled { opacity: 0.55; cursor: wait; }
    .auth-error {
      color: var(--belgian-red);
      font-size: 0.85rem;
      margin: 0.35rem 0 0;
      text-align: center;
    }
    .auth-toggle {
      margin-top: 1.1rem;
      font-size: 0.85rem;
      color: var(--concrete);
      text-align: center;
    }
    .auth-link {
      background: none;
      border: none;
      color: var(--belgian-yellow);
      font: inherit;
      cursor: pointer;
      text-decoration: underline;
      padding: 0;
    }
    .auth-legal {
      margin-top: 1.25rem;
      font-size: 0.7rem;
      color: var(--concrete);
      text-align: center;
    }
    .nav-logout {
      background: transparent;
      border: 1px solid rgba(245,241,232,0.25);
      color: var(--chalk);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.45rem 0.75rem;
      cursor: pointer;
    }
    .nav-logout:hover {
      border-color: var(--belgian-red);
      color: var(--belgian-red);
    }

    /* ============ NAV ============ */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 0 32rem 0 1.75rem;
      height: 64px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: transparent;
      border-bottom: 1px solid transparent;
      transition: background 0.3s ease, border-color 0.3s ease, backdrop-filter 0.3s ease;
    }
    nav.is-solid {
      background: rgba(5, 5, 5, 0.92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom-color: var(--asphalt);
    }
    /* backdrop-filter on nav makes position:fixed children sit in the 64px bar */
    body.nav-open nav,
    body.nav-open nav.is-solid {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    /* ============ BRAND LOGO (flag + white 420) ============ */
    .brand-logo {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      text-decoration: none;
      color: inherit;
    }
    .brand-logo-flag {
      position: relative;
      display: flex;
      width: 42px;
      height: 28px;
      flex-shrink: 0;
      overflow: hidden;
      box-shadow: 0 0 0 1px rgba(245, 241, 232, 0.12);
    }
    .brand-logo-flag .stripe {
      flex: 1;
      height: 100%;
    }
    .brand-logo-flag .stripe-black { background: #0a0a0a; }
    .brand-logo-flag .stripe-yellow { background: var(--belgian-yellow); }
    .brand-logo-flag .stripe-red { background: var(--belgian-red); }
    .brand-logo-420 {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Anton', sans-serif;
      font-size: 0.78rem;
      letter-spacing: 0.06em;
      color: #fff;
      text-shadow:
        0 1px 2px rgba(0,0,0,0.85),
        0 0 8px rgba(0,0,0,0.45);
      line-height: 1;
      pointer-events: none;
    }
    .brand-logo-word {
      font-family: 'Anton', sans-serif;
      font-size: 1.15rem;
      color: var(--chalk);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      line-height: 1;
    }
    .nav-logo {
      text-decoration: none;
      position: relative;
      z-index: 102;
    }
    .nav-toggle {
      display: none;
      position: relative;
      z-index: 102;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 1px solid rgba(245, 241, 232, 0.2);
      background: rgba(5, 5, 5, 0.55);
      cursor: pointer;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 5px;
    }
    .nav-toggle span {
      display: block;
      width: 18px;
      height: 2px;
      background: var(--chalk);
      transition: transform 0.25s, opacity 0.25s;
    }
    .nav-toggle.is-open span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle.is-open span:nth-child(2) { opacity: 0; }
    .nav-toggle.is-open span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
    .nav-links {
      display: flex;
      gap: 1.75rem;
      list-style: none;
      align-items: center;
      position: fixed;
      top: 0;
      right: 1.75rem;
      height: 64px;
      z-index: 101;
      margin: 0;
    }
    .nav-links a {
      color: rgba(245, 241, 232, 0.85);
      text-decoration: none;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--belgian-yellow); }
    .nav-cta {
      padding: 0.5rem 1.15rem !important;
      background: var(--belgian-yellow);
      color: var(--ink) !important;
      font-weight: 700;
    }
    .nav-cta:hover { background: var(--chalk) !important; color: var(--ink) !important; }
    .nav-cta-mobile {
      display: none;
      padding: 0.5rem 0.9rem;
      background: var(--belgian-yellow);
      color: var(--ink);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      text-decoration: none;
      margin-left: auto;
      margin-right: 0.5rem;
    }

    /* ============ HERO ============ */
    .hero {
      position: relative;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      align-items: flex-end;
      padding: 0;
      max-width: none;
      margin: 0;
      overflow: hidden;
      perspective: 1200px;
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(105deg, rgba(5,5,5,0.35) 0%, rgba(5,5,5,0.15) 42%, rgba(5,5,5,0.05) 70%, rgba(5,5,5,0.12) 100%),
        linear-gradient(0deg, rgba(5,5,5,0.35) 0%, transparent 45%),
        url('/brand/belgium-flag-grunge.jpg') center / cover no-repeat;
      transform-style: preserve-3d;
      transform: translateZ(-20px);
      opacity: 0.32;          /* heavily softened so the smokey-shader shows through */
      filter: blur(5px);      /* dissolve the grunge into the smoke */
    }
    @media (max-width: 560px) {
      .hero-bg { opacity: 0.22; filter: blur(3px); }
    }
    @media (min-width: 561px) and (max-width: 900px) {
      .hero-bg { opacity: 0.28; filter: blur(4px); }
    }
    .hero-bg::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      opacity: 0.08;
      animation: noiseDrift 20s linear infinite;
    }
    @keyframes noiseDrift {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }
    .hero-content {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 720px;
      padding: 7rem 2rem 4.5rem;
      transform-style: preserve-3d;
    }
    .hero-brand {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.25rem;
      opacity: 0;
      transform: translateY(18px) translateZ(10px);
      animation: heroRise 0.9s ease 0.15s forwards, heroFloat 8s ease-in-out infinite alternate;
    }
    @keyframes heroFloat {
      0%, 100% { transform: translateY(0) translateZ(10px) rotateX(2deg); }
      50% { transform: translateY(-8px) translateZ(16px) rotateX(-2deg); }
    }
    .hero-brand .brand-logo-flag {
      width: clamp(72px, 14vw, 120px);
      height: clamp(48px, 9.3vw, 80px);
      transform: translateZ(5px);
    }
    .hero-brand .brand-logo-420 {
      font-size: clamp(1.35rem, 3.5vw, 2.35rem);
      letter-spacing: 0.04em;
      text-shadow:
        0 1px 2px rgba(0,0,0,0.85),
        0 0 8px rgba(0,0,0,0.45),
        0 0 16px rgba(245, 196, 0, 0.2);
    }
    .hero-brand .brand-logo-word {
      font-size: clamp(2.5rem, 8vw, 5rem);
      letter-spacing: 0.04em;
      background: linear-gradient(90deg, var(--chalk) 0%, var(--belgian-yellow) 50%, var(--chalk) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      text-shadow: 0 0 20px rgba(245, 196, 0, 0.3);
    }
    .hero-title {
      font-family: 'Anton', sans-serif;
      font-size: clamp(1.35rem, 3.2vw, 2rem);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      line-height: 1.15;
      color: var(--chalk);
      margin-bottom: 1rem;
      opacity: 0;
      transform: translateY(18px);
      animation: heroRise 0.9s ease 0.32s forwards;
    }
    .hero-desc {
      color: rgba(245, 241, 232, 0.82);
      font-size: 1rem;
      max-width: 28rem;
      margin-bottom: 1.75rem;
      opacity: 0;
      transform: translateY(18px);
      animation: heroRise 0.9s ease 0.48s forwards;
    }
    .hero-cta {
      opacity: 0;
      transform: translateY(18px);
      animation: heroRise 0.9s ease 0.62s forwards;
    }
    @keyframes heroRise {
      to { opacity: 1; transform: translateY(0); }
    }
    
    /* ============ 3D FLOATING ELEMENTS ============ */
    .hero-3d {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }
    .hero-3d-element {
      position: absolute;
      border-radius: 50%;
      filter: blur(12px);
      opacity: 0.12;
      animation: floatDrift 12s ease-in-out infinite;
    }
    .hero-3d-circle-1 {
      width: 180px;
      height: 180px;
      background: linear-gradient(135deg, rgba(245, 196, 0, 0.4), rgba(245, 196, 0, 0.1));
      top: 15%;
      left: 8%;
      animation-delay: 0s;
    }
    .hero-3d-circle-2 {
      width: 140px;
      height: 140px;
      background: linear-gradient(135deg, rgba(227, 28, 35, 0.35), rgba(227, 28, 35, 0.1));
      bottom: 18%;
      right: 12%;
      animation-delay: 2s;
    }
    .hero-3d-circle-3 {
      width: 100px;
      height: 100px;
      background: linear-gradient(135deg, rgba(245, 241, 232, 0.28), rgba(245, 241, 232, 0.15));
      top: 55%;
      right: 25%;
      animation-delay: 4s;
    }
    @keyframes floatDrift {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      25% { transform: translateY(-12px) rotate(5deg); }
      50% { transform: translateY(-8px) rotate(-3deg); }
      75% { transform: translateY(-16px) rotate(2deg); }
    }
    
    .btn {
      display: inline-block;
      padding: 0.95rem 2rem;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      text-decoration: none;
      transition: transform 0.2s, background 0.2s, color 0.2s, border-color 0.2s;
      cursor: pointer;
      border: none;
    }
    .btn-primary {
      background: var(--belgian-yellow);
      color: var(--ink);
    }
    .btn-primary:hover {
      background: var(--chalk);
      transform: translateY(-2px);
    }

    /* ============ MARQUEE ============ */
    .marquee {
      background: var(--belgian-yellow);
      padding: 0.8rem 0;
      overflow: hidden;
      white-space: nowrap;
      border-top: 2px solid var(--ink);
      border-bottom: 2px solid var(--ink);
    }
    .marquee-inner {
      display: inline-block;
      animation: marquee 30s linear infinite;
    }
    .marquee span {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--ink);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin: 0 1.75rem;
    }
    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* ============ TEXT PATH (sine-wave marquee, Originkit-style) ============ */
    .textpath-band {
      position: relative;
      background: var(--asphalt);
      overflow: hidden;
      border-bottom: 2px solid var(--ink);
    }
    .textpath-band svg {
      display: block;
      width: 100%;
      height: 150px;
    }
    .textpath-text {
      font-family: 'Anton', sans-serif;
      font-size: 40px;
      letter-spacing: 0.08em;
      fill: var(--belgian-yellow);
      text-transform: uppercase;
    }
    @media (max-width: 560px) {
      .textpath-band svg { height: 100px; }
      .textpath-text { font-size: 28px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .textpath-scroll { animation: none !important; }
    }

    /* ============ TEXTMODE AUTOMATA BAND ============ */
    .automata-band {
      position: relative;
      background: var(--belgian-black);
      overflow: hidden;
      border-bottom: 2px solid var(--ink);
    }
    #flagAutomata,
    #flagAutomata canvas {
      display: block;
      width: 100%;
      height: 240px;
    }
    @media (max-width: 560px) {
      #flagAutomata, #flagAutomata canvas { height: 160px; }
    }

    /* ============ SECTIONS ============ */
    section {
      padding: 5rem 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }
    .section-header { margin-bottom: 2.5rem; }
    .section-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      color: var(--belgian-yellow);
      text-transform: uppercase;
      letter-spacing: 0.18em;
      margin-bottom: 0.5rem;
    }
    .section-title {
      font-family: 'Anton', sans-serif;
      font-size: clamp(2rem, 4vw, 3rem);
      text-transform: uppercase;
      letter-spacing: 0.02em;
      line-height: 1;
      color: var(--chalk);
    }
    .section-desc {
      color: rgba(245, 241, 232, 0.72);
      max-width: 560px;
      margin-top: 1rem;
      font-size: 0.95rem;
    }

    /* ============ COLLECTIONS ============ */
    .collections {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      background: var(--belgian-black);
      max-width: none;
      padding-left: max(2rem, calc((100% - 1200px) / 2 + 2rem));
      padding-right: max(2rem, calc((100% - 1200px) / 2 + 2rem));
    }
    .collections::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background:
        linear-gradient(180deg, rgba(5,5,5,0.9) 0%, rgba(5,5,5,0.78) 48%, rgba(5,5,5,0.94) 100%),
        url('/brand/belgium-flag-grunge.jpg') center / cover no-repeat;
      opacity: 0.42;
    }
    .collections::after {
      content: '';
      position: absolute;
      inset: -18%;
      z-index: 0;
      pointer-events: none;
      background:
        radial-gradient(ellipse 48% 42% at 6% 38%, rgba(245, 196, 0, 0.28), transparent 62%),
        radial-gradient(ellipse 46% 44% at 94% 72%, rgba(227, 28, 35, 0.24), transparent 62%);
      filter: blur(48px);
    }
    .collections > * {
      position: relative;
      z-index: 1;
    }
    .collections-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1rem;
      background: transparent;
    }
    .product-card {
      background: rgba(5, 5, 5, 0.55);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      padding: 0;
      overflow: hidden;
      position: relative;
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease, background 0.25s ease;
      cursor: pointer;
      border: 1px solid rgba(245, 241, 232, 0.12);
    }
    .product-card:hover {
      background: rgba(5, 5, 5, 0.72);
      transform: translateY(-4px);
      z-index: 2;
    }
    .product-card[data-tone="yellow"]:hover {
      border-color: rgba(245, 196, 0, 0.7);
      box-shadow: 0 0 0 1px var(--belgian-yellow), 0 16px 40px rgba(245, 196, 0, 0.28);
    }
    .product-card[data-tone="red"]:hover {
      border-color: rgba(227, 28, 35, 0.7);
      box-shadow: 0 0 0 1px var(--belgian-red), 0 16px 40px rgba(227, 28, 35, 0.32);
    }
    .product-card[data-tone="black"]:hover {
      border-color: rgba(245, 241, 232, 0.35);
      box-shadow: 0 0 0 1px rgba(245, 241, 232, 0.28), 0 16px 40px rgba(245, 196, 0, 0.16);
    }
    .product-card-coa {
      position: absolute;
      top: 1rem;
      right: 1rem;
      z-index: 2;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.58rem;
      color: var(--belgian-yellow);
      border: 1px solid rgba(245, 196, 0, 0.4);
      padding: 0.2rem 0.45rem;
      background: rgba(5,5,5,0.62);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    .product-card-img {
      width: 100%;
      height: 260px;
      margin-bottom: 0;
      display: flex;
      align-items: flex-end;
      justify-content: flex-start;
      padding: 1rem;
      position: relative;
      overflow: hidden;
      background-size: cover;
      background-position: center;
    }
    .product-card-img[data-tone="black"] {
      background:
        radial-gradient(circle at 80% 20%, rgba(245,196,0,0.18), transparent 45%),
        linear-gradient(145deg, #0a0a0a, #1a1a1a);
    }
    .product-card-img[data-tone="yellow"] {
      background:
        radial-gradient(circle at 20% 80%, rgba(5,5,5,0.35), transparent 50%),
        linear-gradient(145deg, #F5C400, #d4a800);
    }
    .product-card-img[data-tone="red"] {
      background:
        radial-gradient(circle at 70% 30%, rgba(245,241,232,0.12), transparent 40%),
        linear-gradient(145deg, #E31C23, #a81218);
    }
    .product-card-img[data-has-img="true"] {
      background-size: cover;
      background-position: center;
    }
    .product-card-img[data-has-img="true"]::before {
      content: '';
      position: absolute;
      inset: -10%;
      z-index: 0;
      background-image: inherit;
      background-size: cover;
      background-position: center;
      transition: transform 0.5s ease;
      pointer-events: none;
    }
    .product-card:hover .product-card-img[data-has-img="true"]::before {
      transform: scale(1.08);
    }
    .product-card-img[data-has-img="true"] .product-card-mark {
      display: none;
    }
    .product-card-img::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      opacity: 0.12;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      pointer-events: none;
    }
    .product-card-img[data-has-img="true"]::after {
      opacity: 1;
      background-image: linear-gradient(to top, rgba(5,5,5,0.62) 0%, rgba(5,5,5,0.12) 42%, transparent 70%);
    }
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      .product-card,
      .cat-chip:not(.is-active),
      .effect-chip:not(.is-active),
      .type-chip:not(.is-active),
      .product-card-coa {
        background: var(--asphalt);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .product-card,
      .product-card-img[data-has-img="true"]::before {
        transition: none;
      }
      .product-card:hover { transform: none; }
      .product-card:hover .product-card-img[data-has-img="true"]::before { transform: none; }
    }
    .product-card-mark {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      position: relative;
      z-index: 1;
    }
    .product-card-img[data-tone="black"] .product-card-mark { color: var(--belgian-yellow); }
    .product-card-img[data-tone="yellow"] .product-card-mark { color: var(--ink); }
    .product-card-img[data-tone="red"] .product-card-mark { color: var(--chalk); }
    .product-card-name {
      font-family: 'Anton', sans-serif;
      font-size: 1rem;
      text-transform: uppercase;
      color: var(--chalk);
      margin-bottom: 0.25rem;
      letter-spacing: 0.02em;
    }
    .product-card-body {
      padding: 1rem 1.1rem 1.15rem;
    }
    .product-card-type {
      font-size: 0.75rem;
      color: var(--concrete);
      margin-bottom: 0.4rem;
    }
    .product-card-price {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1rem;
      color: var(--belgian-yellow);
      font-weight: 600;
    }
    .product-variants {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.75rem;
    }
    .product-variant {
      flex: 1 1 auto;
      min-width: 0;
      padding: 0.45rem 0.4rem;
      background: var(--asphalt);
      color: rgba(245, 241, 232, 0.85);
      border: 1px solid transparent;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.62rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .product-variant:hover {
      border-color: rgba(245, 196, 0, 0.45);
      color: var(--chalk);
    }
    .product-variant.is-selected {
      background: var(--belgian-yellow);
      color: var(--ink);
      border-color: var(--belgian-yellow);
    }
    .product-variant-price {
      display: block;
      margin-top: 0.12rem;
      opacity: 0.8;
      font-size: 0.58rem;
    }
    .product-variant.is-selected .product-variant-price { opacity: 1; }
    .product-card-thc {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.62rem;
      color: var(--concrete);
      margin-top: 0.45rem;
    }
    .product-card-extras {
      overflow: hidden;
      max-height: 0;
      opacity: 0;
      transform: translateY(-4px);
      transition: max-height 0.28s ease, opacity 0.22s ease, transform 0.22s ease;
    }
    .product-card:hover .product-card-extras,
    .product-card:focus-within .product-card-extras {
      max-height: 220px;
      opacity: 1;
      transform: translateY(0);
    }
    .product-card-sizes {
      display: block;
      margin-top: 0.35rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.58rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--concrete);
    }
    .add-to-cart {
      display: block;
      width: 100%;
      margin-top: 0.85rem;
      padding: 0.65rem 0.5rem;
      background: var(--belgian-yellow);
      color: var(--ink);
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      border: none;
      cursor: pointer;
      transition: background 0.15s, transform 0.1s;
    }
    .add-to-cart:hover { background: var(--chalk); transform: translateY(-1px); }
    .add-to-cart:active { transform: translateY(0); }
    .inquire-btn {
      display: block;
      width: 100%;
      margin-top: 0.85rem;
      padding: 0.65rem 0.5rem;
      background: transparent;
      color: var(--chalk);
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      border: 1px solid var(--belgian-yellow);
      cursor: pointer;
      text-decoration: none;
      text-align: center;
      transition: background 0.15s, color 0.15s;
    }
    .inquire-btn:hover { background: var(--belgian-yellow); color: var(--ink); }
    .product-card-inquiry-note {
      margin-top: 0.45rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.58rem;
      color: var(--concrete);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      text-align: center;
      opacity: 0.75;
    }
    .product-card-price:has(+ *) { /* fall-through for inquiry cards layout */ }

    /* ============ CART NAV BUTTON ============ */
    .nav-cart-btn {
      position: relative;
      z-index: 102;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      flex-shrink: 0;
      margin-left: auto;
      margin-right: 0.35rem;
      background: transparent;
      border: 1px solid rgba(245, 241, 232, 0.25);
      color: var(--chalk);
      cursor: pointer;
      font-size: 1.05rem;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
      transition: border-color 0.15s, color 0.15s;
    }
    .nav-cart-btn:hover { border-color: var(--belgian-yellow); color: var(--belgian-yellow); }
    .nav-cart-count {
      position: absolute;
      top: -6px;
      right: -6px;
      min-width: 18px;
      height: 18px;
      padding: 0 5px;
      background: var(--belgian-red);
      color: var(--chalk);
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.65rem;
      font-weight: 700;
      border-radius: 9px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .nav-cart-count.is-hidden { display: none; }

    /*
      CART DRAWER — must be :global.
      The panel is created by cart-ui.ts (no Astro scope attr), so scoped
      `.cart-drawer[data-astro-cid-…]` never matched and the drawer was invisible.
    */
    :global(body.cart-locked) { overflow: hidden; }
    :global(.cart-drawer) {
      position: fixed;
      inset: 0;
      z-index: 10050;
      pointer-events: none;
    }
    :global(.cart-drawer.is-open) { pointer-events: auto; }
    :global(.cart-drawer-backdrop) {
      position: absolute;
      inset: 0;
      background: rgba(5, 5, 5, 0.6);
      opacity: 0;
      transition: opacity 0.25s;
    }
    :global(.cart-drawer.is-open .cart-drawer-backdrop) { opacity: 1; }
    :global(.cart-drawer-panel) {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(420px, 100%);
      background: var(--asphalt);
      color: var(--chalk);
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform 0.3s ease;
      box-shadow: -8px 0 28px rgba(0, 0, 0, 0.45);
    }
    :global(.cart-drawer.is-open .cart-drawer-panel) { transform: translateX(0); }
    :global(.cart-drawer-head) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid rgba(245, 241, 232, 0.1);
    }
    :global(.cart-drawer-head h2) {
      font-family: 'Anton', sans-serif;
      font-size: 1.25rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    :global(.cart-drawer-close) {
      background: transparent;
      border: none;
      color: var(--chalk);
      font-size: 1.6rem;
      line-height: 1;
      cursor: pointer;
      padding: 0 0.5rem;
    }
    :global(.cart-drawer-body) {
      flex: 1;
      overflow-y: auto;
      padding: 0.5rem 1.5rem;
    }
    :global(.cart-drawer-foot) {
      padding: 1.25rem 1.5rem;
      border-top: 1px solid rgba(245, 241, 232, 0.1);
      background: var(--belgian-black);
    }
    :global(.cart-empty) {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--concrete);
    }
    :global(.cart-empty-mark) {
      font-size: 2rem;
      color: var(--belgian-yellow);
      margin-bottom: 0.75rem;
    }
    :global(.cart-empty-link) {
      display: inline-block;
      margin-top: 1rem;
      padding: 0.6rem 1.2rem;
      background: var(--belgian-yellow);
      color: var(--ink);
      font-weight: 700;
      text-decoration: none;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    :global(.cart-row) {
      display: grid;
      grid-template-columns: 48px 1fr auto auto;
      gap: 0.75rem;
      align-items: center;
      padding: 0.85rem 0;
      border-bottom: 1px solid rgba(245, 241, 232, 0.06);
    }
    :global(.cart-row-img) {
      width: 48px;
      height: 48px;
      background: var(--belgian-black) center / cover no-repeat;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--belgian-yellow);
      font-size: 0.9rem;
    }
    :global(.cart-row-meta) { min-width: 0; }
    :global(.cart-row-name) {
      font-family: 'Anton', sans-serif;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    :global(.cart-row-type) {
      font-size: 0.7rem;
      color: var(--concrete);
      margin-top: 0.15rem;
    }
    :global(.cart-row-batch) {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      color: var(--concrete);
      margin-top: 0.15rem;
    }
    :global(.cart-row-price) {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--belgian-yellow);
    }
    :global(.cart-row-remove) {
      background: transparent;
      border: none;
      color: var(--concrete);
      font-size: 1.2rem;
      line-height: 1;
      cursor: pointer;
      padding: 0 0.25rem;
    }
    :global(.cart-row-remove:hover) { color: var(--belgian-red); }
    :global(.cart-foot-row) {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: 'JetBrains Mono', monospace;
      margin-bottom: 0.5rem;
    }
    :global(.cart-foot-row strong) { color: var(--belgian-yellow); font-size: 1.1rem; }
    :global(.cart-foot-note) {
      font-size: 0.7rem;
      color: var(--concrete);
      margin: 0.5rem 0 1rem;
      line-height: 1.4;
    }
    :global(.cart-checkout-btn) {
      display: block;
      width: 100%;
      padding: 0.85rem;
      background: var(--belgian-yellow);
      color: var(--ink);
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      text-align: center;
      text-decoration: none;
      border: none;
      cursor: pointer;
    }
    :global(.cart-checkout-btn:hover) { background: var(--chalk); }
    :global(.cart-clear-btn) {
      display: block;
      width: 100%;
      margin-top: 0.6rem;
      padding: 0.5rem;
      background: transparent;
      color: var(--concrete);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border: none;
      cursor: pointer;
    }
    :global(.cart-clear-btn:hover) { color: var(--belgian-red); }
    @media (max-width: 640px) {
      :global(.cart-drawer-panel) { width: 100%; }
    }
    .product-card-tag {
      position: absolute;
      top: 1rem;
      left: 1rem;
      z-index: 2;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.58rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 0.22rem 0.5rem;
      background: rgba(227, 28, 35, 0.92);
      color: var(--chalk);
    }
    .product-card-tag[data-tag="pounds"] {
      background: rgba(245, 196, 0, 0.95);
      color: var(--ink);
    }

    .shop-filters {
      margin: 0 0 2rem;
      padding: 1rem 1.15rem 1.1rem;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 28px;
      background: rgba(8, 8, 8, 0.5);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
    }
    .shop-filters .filter-source {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.62rem;
      color: var(--concrete);
      max-width: 46rem;
      margin: 0 0 0.95rem;
      line-height: 1.45;
    }
    .filter-row {
      display: grid;
      grid-template-columns: 5.4rem minmax(0, 1fr);
      gap: 0.45rem 0.85rem;
      align-items: start;
      margin: 0 0 0.7rem;
    }
    .filter-row:last-of-type { margin-bottom: 0; }
    .filter-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--belgian-yellow);
      margin: 0.55rem 0 0;
    }
    .effect-bar,
    .type-bar,
    .cat-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin: 0;
      padding: 0;
      border: 0;
    }
    .effect-chip,
    .type-chip,
    .cat-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.42rem 0.85rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      color: rgba(245, 241, 232, 0.82);
      border: 1px solid rgba(245, 241, 232, 0.14);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      cursor: pointer;
      transition: border-color 0.18s, color 0.18s, background 0.18s, box-shadow 0.18s;
      white-space: nowrap;
    }
    .effect-chip:hover,
    .type-chip:hover {
      border-color: var(--belgian-red);
      color: var(--chalk);
    }
    .cat-chip:hover {
      border-color: var(--belgian-yellow);
      color: var(--chalk);
    }
    .effect-chip.is-active,
    .type-chip.is-active {
      background: var(--belgian-red);
      color: var(--chalk);
      border-color: var(--belgian-red);
      box-shadow: 0 0 18px rgba(227, 28, 35, 0.32);
    }
    .type-chip[data-type="branded"].is-active {
      background: var(--belgian-yellow);
      color: var(--ink);
      border-color: var(--belgian-yellow);
      box-shadow: 0 0 18px rgba(245, 196, 0, 0.32);
    }
    .cat-chip.is-active {
      background: var(--belgian-yellow);
      color: var(--ink);
      border-color: var(--belgian-yellow);
      box-shadow: 0 0 18px rgba(245, 196, 0, 0.32);
    }
    .effect-chip-count,
    .type-chip-count,
    .cat-chip-count {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.58rem;
      padding: 0.08rem 0.38rem;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.28);
      font-weight: 700;
    }
    .cat-chip:not(.is-active) .cat-chip-count {
      background: rgba(245, 241, 232, 0.08);
      color: var(--concrete);
    }
    .effect-chip[hidden],
    .type-chip[hidden],
    .cat-chip[hidden],
    .effect-chip.is-empty,
    .type-chip.is-empty,
    .cat-chip.is-empty {
      display: none !important;
    }
    .cat-chip-mark {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.62rem;
      opacity: 0.7;
    }
    .cat-empty {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      color: var(--concrete);
      text-align: center;
      padding: 3rem 0;
    }

    /* ============ LAB ============ */
    .lab {
      position: relative;
      background: var(--belgian-red);
      padding: 5rem 2rem;
      max-width: none;
      overflow: hidden;
    }
    .lab-molecules {
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0.14;
    }
    .lab-molecules svg {
      position: absolute;
      stroke: var(--chalk);
      fill: none;
      stroke-width: 1.2;
    }
    .lab-molecules .m1 { width: 180px; top: 12%; right: 8%; }
    .lab-molecules .m2 { width: 140px; bottom: 18%; left: 6%; }
    .lab-molecules .m3 { width: 120px; top: 40%; left: 35%; opacity: 0.7; }
    .lab-inner {
      position: relative;
      z-index: 1;
      max-width: 1200px;
      margin: 0 auto;
    }
    .lab .section-tag { color: rgba(245, 241, 232, 0.65); }
    .lab .section-title { color: var(--chalk); }
    .lab .section-desc { color: rgba(245, 241, 232, 0.82); }
    .lab-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1px;
      margin-top: 2.5rem;
      background: rgba(245, 241, 232, 0.15);
    }
    .lab-card {
      background: rgba(5, 5, 5, 0.28);
      padding: 1.75rem;
      border: none;
    }
    .lab-card-title {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
      color: var(--chalk);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 0.85rem;
    }
    .lab-card-body {
      font-size: 0.88rem;
      color: rgba(245, 241, 232, 0.82);
      line-height: 1.7;
    }
    .lab-card-body strong { color: var(--chalk); }
    .coa-table {
      width: 100%;
      margin-top: 2rem;
      border-collapse: collapse;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      background: rgba(5, 5, 5, 0.35);
    }
    .coa-table th {
      text-align: left;
      padding: 0.75rem;
      color: var(--belgian-yellow);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      border-bottom: 1px solid rgba(245, 241, 232, 0.2);
      font-weight: 600;
    }
    .coa-table td {
      padding: 0.75rem;
      color: rgba(245, 241, 232, 0.82);
      border-bottom: 1px solid rgba(245, 241, 232, 0.1);
    }
    .coa-table .pass { color: #7dff9a; }

    /* ============ SHIPPING ============ */
    .shipping {
      background: var(--belgian-black);
      max-width: none;
      padding-left: max(2rem, calc((100% - 1200px) / 2 + 2rem));
      padding-right: max(2rem, calc((100% - 1200px) / 2 + 2rem));
    }
    .shipping-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1px;
      margin-top: 2rem;
      background: var(--asphalt);
    }
    .shipping-card {
      background: var(--belgian-black);
      border: none;
      padding: 1.75rem;
    }
    .shipping-card h3 {
      font-family: 'Anton', sans-serif;
      font-size: 1rem;
      text-transform: uppercase;
      color: var(--chalk);
      margin-bottom: 0.75rem;
      letter-spacing: 0.03em;
    }
    .shipping-card p {
      font-size: 0.85rem;
      color: rgba(245, 241, 232, 0.72);
      line-height: 1.65;
    }
    .shipping-card strong { color: var(--chalk); }

    /* ============ ABOUT ============ */
    .about {
      background: var(--asphalt);
      max-width: none;
      padding: 5rem 2rem;
      border-top: 1px solid #1f1f1f;
      border-bottom: 1px solid #1f1f1f;
    }
    .about-inner {
      max-width: 720px;
      margin: 0 auto;
    }
    .about .section-desc {
      max-width: none;
      font-size: 1.05rem;
      line-height: 1.75;
    }

    /* ============ FOOTER ============ */
    footer {
      background: var(--belgian-black);
      border-top: 3px solid transparent;
      border-image: linear-gradient(90deg, #050505 0%, #F5C400 50%, #E31C23 100%) 1;
      padding: 3rem 2rem;
    }
    .footer-inner {
      max-width: 1200px;
      margin: 0 auto;
    }
    .footer-disclaimers {
      margin-bottom: 2rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--asphalt);
    }
    .footer-disclaimers p {
      font-size: 0.68rem;
      color: var(--concrete);
      line-height: 1.75;
      margin-bottom: 0.5rem;
    }
    .footer-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .footer-copy {
      font-size: 0.8rem;
      color: var(--concrete);
    }
    .footer-links {
      display: flex;
      gap: 1.5rem;
      list-style: none;
    }
    .footer-links a {
      font-size: 0.72rem;
      color: var(--concrete);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .footer-links a:hover { color: var(--belgian-yellow); }

    /* ============ SCROLL RAIL (Rare UI) ============ */
    .scroll-rail {
      position: fixed;
      inset: 0 0 auto 0;
      height: 3px;
      z-index: 102;
      pointer-events: none;
      background: rgba(255,255,255,0.06);
    }
    .scroll-rail-bar {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--belgian-black) 0 33%, var(--belgian-yellow) 33% 66%, var(--belgian-red) 66% 100%);
      transform-origin: left;
    }
    .scroll-pill {
      position: fixed;
      left: max(0.9rem, env(safe-area-inset-left, 0px));
      bottom: max(1rem, env(safe-area-inset-bottom, 0px));
      z-index: 80;
      display: flex;
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 0.45rem;
    }
    .scroll-pill-btn {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.35rem 0.7rem 0.35rem 0.35rem;
      border: 1px solid rgba(255,255,255,0.16);
      border-radius: 999px;
      background: rgba(8,8,8,0.72);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      color: #fff;
      cursor: pointer;
      font-family: inherit;
      box-shadow: 0 12px 32px rgba(0,0,0,0.35);
    }
    .scroll-pill-btn:hover { border-color: rgba(245,196,0,0.45); }
    .scroll-ring {
      width: 34px;
      height: 34px;
      flex-shrink: 0;
      display: block;
    }
    .scroll-ring-track { stroke: rgba(255,255,255,0.16); }
    .scroll-ring-arc {
      stroke: var(--belgian-yellow);
      stroke-linecap: round;
      transform: rotate(-90deg);
      transform-origin: 12px 12px;
    }
    .scroll-pill-label {
      font-family: 'Anton', sans-serif;
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      min-width: 4.6rem;
      text-align: left;
    }
    .scroll-pill-list {
      display: none;
      flex-direction: column;
      gap: 2px;
      padding: 0.35rem;
      min-width: 9.5rem;
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 16px;
      background: rgba(8,8,8,0.86);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }
    .scroll-pill.is-open .scroll-pill-list { display: flex; }
    .scroll-pill-list a {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      color: rgba(255,255,255,0.72);
      text-decoration: none;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.45rem 0.7rem;
      border-radius: 10px;
    }
    .scroll-pill-list a::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: rgba(255,255,255,0.28);
      flex-shrink: 0;
    }
    .scroll-pill-list a.is-current::before {
      background: var(--belgian-yellow);
    }
    .scroll-pill-list a:hover,
    .scroll-pill-list a.is-current {
      color: var(--belgian-yellow);
      background: rgba(245,196,0,0.1);
    }
    body.nav-open .scroll-pill,
    body.nav-open .shop-cat-dock,
    body.nav-open .shop-filter-wrap,
    body:has(.cart-drawer.is-open) .scroll-pill,
    body:has(.cart-drawer.is-open) .shop-cat-dock,
    body:has(.cart-drawer.is-open) .shop-filter-wrap,
    body:has(#ageGate:not(.hidden)) .scroll-pill,
    body:has(#ageGate:not(.hidden)) .shop-cat-dock,
    body:has(#ageGate:not(.hidden)) .shop-filter-wrap,
    body:has(#ageGate:not(.hidden)) .scroll-rail {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    /* ============ SHOP MID-GRID FILTERS ============ */
    .shop-cat-dock {
      position: fixed;
      left: 0;
      right: 0;
      top: 64px;
      z-index: 90;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      height: 40px;
      padding: 0 1rem;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      background: rgba(5, 5, 5, 0.92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--asphalt);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-6px);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
    }
    .shop-cat-dock::-webkit-scrollbar { display: none; }
    .shop-cat-dock.is-visible {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none;
    }
    .shop-cat-dock .cat-chip {
      flex-shrink: 0;
      padding: 0.28rem 0.7rem;
      font-size: 0.68rem;
    }
    .shop-cat-dock .cat-chip.is-active { transform: none; }
    .shop-cat-dock .cat-chip-mark { font-size: 0.58rem; }
    .shop-cat-dock .cat-chip-count { font-size: 0.55rem; padding: 0.04rem 0.28rem; }

    .shop-filter-wrap {
      position: fixed;
      right: max(0.9rem, env(safe-area-inset-right, 0px));
      bottom: max(1rem, env(safe-area-inset-bottom, 0px));
      z-index: 81;
      display: flex;
      flex-direction: column-reverse;
      align-items: flex-end;
      gap: 0.45rem;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(8px);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
    }
    .shop-filter-wrap.is-visible {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none;
    }
    .shop-filter-fab {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.55rem 0.95rem;
      border: 1px solid rgba(255,255,255,0.16);
      border-radius: 999px;
      background: rgba(8,8,8,0.72);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      color: #fff;
      cursor: pointer;
      font-family: 'Anton', sans-serif;
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      box-shadow: 0 12px 32px rgba(0,0,0,0.35);
    }
    .shop-filter-fab:hover { border-color: rgba(245,196,0,0.45); }
    .shop-filter-badge {
      min-width: 1.15rem;
      height: 1.15rem;
      padding: 0 0.28rem;
      border-radius: 999px;
      background: var(--belgian-yellow);
      color: var(--ink);
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .shop-filter-sheet {
      display: none;
      flex-direction: column;
      gap: 0.85rem;
      width: min(24rem, calc(100vw - 1.8rem));
      max-height: min(68vh, 34rem);
      overflow: auto;
      padding: 0.95rem;
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 24px;
      background: rgba(8,8,8,0.9);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow: 0 16px 40px rgba(0,0,0,0.4);
    }
    .shop-filter-wrap.is-open .shop-filter-sheet { display: flex; }
    .shop-filter-heading {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--belgian-yellow);
      margin-bottom: 0.4rem;
    }
    .shop-filter-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .shop-filter-sheet .effect-chip,
    .shop-filter-sheet .type-chip,
    .shop-filter-sheet .cat-chip {
      padding: 0.38rem 0.72rem;
      font-size: 0.68rem;
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .shop-cat-dock,
      .shop-filter-wrap {
        transition: none;
        transform: none;
      }
    }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 1100px) {
      .nav-links { gap: 1.1rem; }
      .nav-links a { font-size: 0.7rem; letter-spacing: 0.06em; }
      section { padding: 4rem 1.75rem; }
      .collections,
      .shipping {
        padding-left: 1.75rem;
        padding-right: 1.75rem;
      }
      .collections-grid {
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      }
    }

    @media (max-width: 900px) {
      nav {
        padding: 0 1rem;
        height: 60px;
      }
      .shop-cat-dock { top: 60px; }
      .nav-links {
        right: 0;
        height: 100dvh;
      }
      .brand-logo-word { font-size: 1rem; }
      .nav-toggle { display: flex; }
      .nav-cta-mobile { display: inline-flex; align-items: center; }
      .nav-links {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 100dvh;
        z-index: 99;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: stretch;
        gap: 0;
        padding: calc(72px + env(safe-area-inset-top, 0px)) 1.5rem 2rem;
        background: rgba(5, 5, 5, 0.97);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        transform: translateX(100%);
        transition: transform 0.3s ease;
        overflow-y: auto;
        pointer-events: none;
        visibility: hidden;
      }
      .nav-links.is-open {
        transform: translateX(0);
        pointer-events: auto;
        visibility: visible;
      }
      .nav-links li {
        border-bottom: 1px solid var(--asphalt);
      }
      .nav-links a {
        display: block;
        padding: 1.1rem 0.25rem;
        font-size: 1rem;
        letter-spacing: 0.08em;
      }
      .nav-links .nav-cta {
        margin-top: 1.25rem;
        text-align: center;
        padding: 0.95rem 1.15rem !important;
      }
      body.nav-open { overflow: hidden; }

      .hero-bg {
        background:
          linear-gradient(180deg, rgba(5,5,5,0.55) 0%, rgba(5,5,5,0.35) 35%, rgba(5,5,5,0.88) 100%),
          url('/brand/belgium-flag-grunge.jpg') 60% center / cover no-repeat;
      }
      .hero-content {
        padding: 5.5rem 1.25rem 3rem;
        max-width: 100%;
      }
      .hero-brand {
        flex-wrap: wrap;
        gap: 0.75rem;
      }
      .hero-brand .brand-logo-flag {
        width: 64px;
        height: 42px;
      }
      .hero-brand .brand-logo-420 { font-size: 1.2rem; }
      .hero-brand .brand-logo-word {
        font-size: clamp(1.75rem, 9vw, 2.75rem);
        width: 100%;
      }
      .hero-title { font-size: clamp(1.2rem, 4.5vw, 1.6rem); }
      .hero-desc { font-size: 0.95rem; }

      .shop-filters { padding: 0.9rem 0.95rem 1rem; border-radius: 22px; }
      .filter-row {
        grid-template-columns: 1fr;
        gap: 0.35rem;
      }
      .filter-label { margin: 0; }
      .cat-bar,
      .effect-bar,
      .type-bar {
        flex-wrap: nowrap;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        gap: 0.4rem;
        margin-right: -0.5rem;
        padding-right: 0.5rem;
      }
      .cat-bar::-webkit-scrollbar,
      .effect-bar::-webkit-scrollbar,
      .type-bar::-webkit-scrollbar { display: none; }
      .cat-chip,
      .effect-chip,
      .type-chip {
        flex-shrink: 0;
        padding: 0.55rem 0.8rem;
        font-size: 0.7rem;
      }

      .collections-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .product-card { padding: 0; }
      .product-card-img { height: 200px; margin-bottom: 0; }
      .product-card-name { font-size: 0.9rem; }
      .product-card-thc { font-size: 0.58rem; }

      .lab, .about { padding: 3.5rem 1.25rem; }
      .lab-grid { grid-template-columns: 1fr; }
      .coa-table {
        display: block;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        font-size: 0.65rem;
      }
      .coa-table th,
      .coa-table td {
        padding: 0.6rem 0.55rem;
        white-space: nowrap;
      }

      .shipping-grid { grid-template-columns: 1fr; }
      .collections,
      .shipping {
        padding: 3.5rem 1.25rem;
      }
      section { padding: 3.5rem 1.25rem; }

      .footer-links {
        flex-wrap: wrap;
        gap: 0.75rem 1.25rem;
      }
      .footer-bottom {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    @media (max-width: 560px) {
      .age-gate { padding: 1.25rem; }
      .age-gate-buttons {
        flex-direction: column;
        width: 100%;
      }
      .age-btn {
        width: 100%;
        padding: 1rem 1.25rem;
      }
      .age-gate-brand .brand-logo-flag {
        width: 80px;
        height: 54px;
      }
      .age-gate-brand .brand-logo-420 { font-size: 1.3rem; }

      .nav-cta-mobile { display: none; }
      .brand-logo { gap: 0.5rem; }
      .brand-logo-flag {
        width: 36px;
        height: 24px;
      }
      .brand-logo-420 { font-size: 0.65rem; }
      .brand-logo-word { font-size: 0.92rem; }

      .hero {
        min-height: 100svh;
        align-items: flex-end;
      }
      .hero-content { padding: 5rem 1rem 2.5rem; }
      .hero-brand .brand-logo-word {
        font-size: clamp(1.55rem, 10vw, 2.1rem);
      }
      .btn {
        width: 100%;
        text-align: center;
        padding: 1rem 1.25rem;
      }

      .collections-grid { grid-template-columns: 1fr; }
      .product-card-img { height: 220px; }
      .marquee span {
        font-size: 0.7rem;
        margin: 0 1.1rem;
      }
      .section-desc { font-size: 0.9rem; }
      .about .section-desc { font-size: 0.95rem; }
      .lab-molecules .m1,
      .lab-molecules .m2,
      .lab-molecules .m3 { width: 90px; opacity: 0.5; }
      footer { padding: 2.25rem 1rem; }
    }

    @media (min-width: 561px) and (max-width: 900px) {
      .collections-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .hero-brand .brand-logo-word {
        width: auto;
        font-size: clamp(2rem, 5.5vw, 2.8rem);
      }
      .hero-brand { flex-wrap: nowrap; }
    }

    @media (hover: none) {
      .product-card:hover {
        transform: none;
        box-shadow: none;
        background: rgba(5, 5, 5, 0.55);
      }
      .product-card[data-tone="yellow"]:hover,
      .product-card[data-tone="red"]:hover,
      .product-card[data-tone="black"]:hover {
        box-shadow: none;
        border-color: rgba(245, 241, 232, 0.12);
      }
      .product-card:active {
        box-shadow: 0 0 0 1px var(--belgian-yellow);
      }
      .product-card:hover .product-card-img[data-has-img="true"]::before {
        transform: none;
      }
      .product-card-extras {
        max-height: none;
        opacity: 1;
        transform: none;
      }
      .btn-primary:hover { transform: none; }
    }
  </style>
</head>
<body>

  <!-- Smokey Shader: full-bleed Belgian smoke background layer -->
  <div id="smokeBg" aria-hidden="true"></div>

  <!-- Age Gate -->
  <div class="age-gate" id="ageGate">
    <div class="age-gate-bg" aria-hidden="true"></div>
    <div class="age-gate-inner">
      <div class="age-gate-brand brand-logo">
        <span class="brand-logo-flag" aria-hidden="true">
          <span class="stripe stripe-black"></span>
          <span class="stripe stripe-yellow"></span>
          <span class="stripe stripe-red"></span>
          <span class="brand-logo-420">420</span>
        </span>
        <span class="brand-logo-word">Belgium 420</span>
      </div>
      <h2>Are you 21 or older?</h2>
      <p>You must be 21 years or older to enter this site. Please verify your age to continue.</p>
      <div class="age-gate-buttons">
        <button type="button" class="age-btn age-btn-yes">I am 21+</button>
        <button type="button" class="age-btn age-btn-no">I am under 21</button>
      </div>
      <p class="age-gate-legal">By entering, you agree to our Terms of Service and Privacy Policy.</p>
    </div>
  </div>

  {AUTH_ENABLED && (
    <>
      <!-- Auth Gate (SuperTokens email/password + invite) -->
      <div class="auth-gate hidden" id="authGate" aria-live="polite">
        <div class="auth-gate-bg" aria-hidden="true"></div>
        <div class="auth-gate-inner">
          <div class="age-gate-brand brand-logo">
            <span class="brand-logo-flag" aria-hidden="true">
              <span class="stripe stripe-black"></span>
              <span class="stripe stripe-yellow"></span>
              <span class="stripe stripe-red"></span>
              <span class="brand-logo-420">420</span>
            </span>
            <span class="brand-logo-word">Belgium 420</span>
          </div>
          <h2 id="authTitle">Friends &amp; family access</h2>
          <p class="auth-lead">Tap the flag bands in order, then sign in to shop.</p>

          <div id="authChallenge">
            <div class="stripe-challenge" role="group" aria-label="Flag stripe challenge">
              <button type="button" class="stripe-btn" data-stripe="black">Black</button>
              <button type="button" class="stripe-btn" data-stripe="yellow">Yellow</button>
              <button type="button" class="stripe-btn" data-stripe="red">Red</button>
            </div>
            <p id="challengeStatus">Tap black → yellow → red</p>
          </div>

          <div id="authFormWrap" hidden>
            <form class="auth-form" id="authForm" data-mode="signin">
              <label>
                Email
                <input type="email" name="email" autocomplete="username" required />
              </label>
              <label>
                Password
                <input type="password" name="password" autocomplete="current-password" required minlength="8" />
              </label>
              <label id="inviteField" hidden>
                Invite code
                <input type="text" name="invite" autocomplete="off" spellcheck="false" />
              </label>
              <button type="submit" class="auth-submit" id="authSubmit">Enter shop</button>
              <p class="auth-error" id="authError" hidden></p>
            </form>
            <p class="auth-toggle" id="authToggle"></p>
          </div>
          <p class="auth-legal">Invite-only F&amp;F access via SuperTokens (Argon2id sessions).</p>
        </div>
      </div>
    </>
  )}

  <!-- Nav -->
  <nav id="siteNav">
    <a href="/" class="nav-logo brand-logo" aria-label="Belgium420">
      <span class="brand-logo-flag" aria-hidden="true">
        <span class="stripe stripe-black"></span>
        <span class="stripe stripe-yellow"></span>
        <span class="stripe stripe-red"></span>
        <span class="brand-logo-420">420</span>
      </span>
      <span class="brand-logo-word">Belgium 420</span>
    </a>
    <a href="#shop" class="nav-cta-mobile">Shop</a>
    <button type="button" class="nav-cart-btn" id="cartToggle" aria-label="Open cart">
      <span class="nav-cart-icon" aria-hidden="true">🛒</span>
      <span class="nav-cart-count is-hidden" id="cartCount">0</span>
    </button>
    <button class="nav-toggle" id="navToggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </nav>
  <ul class="nav-links" id="navLinks">
      <li><a href="#shop">Shop</a></li>
      <li><a href="#lab">Lab Results</a></li>
      <li><a href="#shipping">Shipping</a></li>
      <li><a href="#about">About</a></li>
      {AUTH_ENABLED && (
        <li><button type="button" class="nav-logout" id="logoutBtn" hidden>Log out</button></li>
      )}
      <li><a href="#shop" class="nav-cta">Shop Now</a></li>
    </ul>

  <!-- Hero -->
  <section class="hero" id="top" aria-label="Belgium420">
    <div class="hero-bg" role="img" aria-label="Belgian flag grunge artwork with Brussels skyline and cannabinoid structures"></div>
    <div class="hero-content">
      <div class="hero-brand brand-logo" aria-label="Belgium420">
        <span class="brand-logo-flag" aria-hidden="true">
          <span class="stripe stripe-black"></span>
          <span class="stripe stripe-yellow"></span>
          <span class="stripe stripe-red"></span>
          <span class="brand-logo-420">420</span>
        </span>
