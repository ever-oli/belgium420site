const effectDefs = [
  { id: 'chill',     label: 'Chill' },
  { id: 'creative',  label: 'Creative' },
  { id: 'energy',    label: 'Energy' },
  { id: 'euphoric',  label: 'Euphoric' },
  { id: 'focus',     label: 'Focus' },
  { id: 'sleep',     label: 'Sleep' },
  { id: 'social',    label: 'Social' },
];

function formatPriceLabel(p, variants) {
  if (variants.length >= 2) {
    const prices = variants.map((v) => v.price);
    const min = Math.min(...prices);
    const max = Math.max(...prices);
    if (min === max) return `$${min.toFixed(2)}`;
    return `$${min.toFixed(2)}–$${max.toFixed(2)}`;
  }
  return p.price;
}

const categoryCounts = categoryDefs.map((c) => ({
  ...c,
  count: c.id === 'all' ? products.length : products.filter((p) => p.categories.includes(c.id)).length,
}));

const effectCounts = [
  { id: 'all', label: 'All', count: products.length },
  ...effectDefs.map((e) => ({
    ...e,
    count: products.filter((p) => inferEffects(p).includes(e.id)).length,
  })),
];

const typeCounts = [
  { id: 'all', label: 'All', count: products.length },
  ...typeDefs.map((t) => ({
    ...t,
    count: products.filter((p) => inferType(p) === t.id).length,
  })),
];
