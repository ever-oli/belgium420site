      if (e.key === "Escape") {
        if (!dialog.hidden) closeDialog(null);
        else if (!modal.hidden) closeModal();
      }
    });

    async function setStatus(id: string, status: string) {
      const k = getKey();
      if (!k) return;
      try {
        const r = await fetch(`/api/orders.php?key=${encodeURIComponent(k)}&id=${encodeURIComponent(id)}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ status }),
        });
        const data = await r.json();
        if (!data.ok) {
          alert("Could not update: " + (data.error || "unknown"));
          return;
        }
        await loadOrders();
        void loadRewards();
        const updated = allOrders.find((x) => x.id === id);
        if (updated) openModal(updated);
      } catch (err) {
        alert("Network error.");
      }
    }

    async function saveTracking(id: string) {
      const k = getKey();
      if (!k) return;
      const input = document.getElementById("trackInput") as HTMLInputElement;
      const tracking = input.value.trim();
      try {
        const r = await fetch(`/api/orders.php?key=${encodeURIComponent(k)}&id=${encodeURIComponent(id)}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ tracking }),
        });
        const data = await r.json();
        if (!data.ok) {
          alert("Could not save: " + (data.error || "unknown"));
          return;
        }
        await loadOrders();
        const updated = allOrders.find((x) => x.id === id);
        if (updated) openModal(updated);
      } catch (err) {
        alert("Network error.");
      }
    }

    async function deleteOrder(id: string) {
      const ok = await askDialog({
        title: "Delete order?",
        body: `Permanently delete ${id}? This cannot be undone.`,
        okLabel: "Delete",
        danger: true,
      });
      if (!ok) return;
      const k = getKey();
      if (!k) return;
      try {
        const r = await fetch(`/api/orders.php?key=${encodeURIComponent(k)}&id=${encodeURIComponent(id)}`, {
          method: "DELETE",
        });
        const data = await r.json();
        if (!data.ok) {
          alert("Could not delete: " + (data.error || "unknown"));
          return;
        }
        closeModal();
        await loadOrders();
      } catch (err) {
        alert("Network error.");
      }
    }

