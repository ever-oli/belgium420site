    function showTab(which: "overview" | "orders" | "rewards") {
      currentTab = which;
      overviewPanel.hidden = which !== "overview";
      ordersPanel.hidden = which !== "orders";
      rewardsPanel.hidden = which !== "rewards";
      tabOverview.classList.toggle("is-on", which === "overview");
      tabOrders.classList.toggle("is-on", which === "orders");
      tabRewards.classList.toggle("is-on", which === "rewards");
      if (location.hash.replace("#", "") !== which) {
        history.replaceState(null, "", `#${which}`);
      }
      if (which === "rewards" || which === "overview") void loadRewards();
    }
    tabOverview.addEventListener("click", () => showTab("overview"));
    tabOrders.addEventListener("click", () => showTab("orders"));
    tabRewards.addEventListener("click", () => showTab("rewards"));
    window.addEventListener("hashchange", () => {
      const hash = (location.hash || "").replace("#", "");
      if (hash === "overview" || hash === "orders" || hash === "rewards") showTab(hash);
    });

    function closeDialog(value: any) {
      dialog.hidden = true;
      const r = dialogResolve;
      dialogResolve = null;
      r?.(value);
    }
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) closeDialog(null);
    });

    function askDialog(opts: {
      title: string;
      body: string;
      okLabel?: string;
      danger?: boolean;
      fields?: { name: string; label: string; value?: string; type?: string; placeholder?: string; required?: boolean }[];
    }): Promise<any> {
      return new Promise((resolve) => {
        dialogResolve = resolve;
        const fields = opts.fields || [];
        dialogBody.innerHTML = `
          <div class="modal-head">
            <h2>${escapeHtml(opts.title)}</h2>
            <button type="button" class="modal-close" data-cancel>&times;</button>
          </div>
          <p class="panel-lead" style="margin-bottom:1rem">${escapeHtml(opts.body)}</p>
          <form id="dialogForm">
            ${fields.map((f) => `
              <div class="field">
                <label class="field-label" for="dlg-${escapeHtml(f.name)}">${escapeHtml(f.label)}</label>
                <input class="field-input" id="dlg-${escapeHtml(f.name)}" name="${escapeHtml(f.name)}" type="${escapeHtml(f.type || "text")}" value="${escapeHtml(f.value || "")}" placeholder="${escapeHtml(f.placeholder || "")}" ${f.required ? "required" : ""} />
              </div>
            `).join("")}
            <div class="modal-actions">
              <button type="button" class="modal-btn secondary" data-cancel>Cancel</button>
              <button type="submit" class="modal-btn${opts.danger ? " danger" : ""}">${escapeHtml(opts.okLabel || "Confirm")}</button>
            </div>
          </form>
        `;
        dialog.hidden = false;
        dialogBody.querySelectorAll("[data-cancel]").forEach((b) => b.addEventListener("click", () => closeDialog(null)));
        dialogBody.querySelector("#dialogForm")?.addEventListener("submit", (e) => {
          e.preventDefault();
          if (fields.length === 0) {
            closeDialog(true);
            return;
          }
          const fd = new FormData(e.target as HTMLFormElement);
          const out: Record<string, string> = {};
          for (const f of fields) out[f.name] = String(fd.get(f.name) || "");
          closeDialog(out);
        });
      });
    }

    async function apiRewards(body?: Record<string, unknown>): Promise<{ ok: boolean; status: number; error: string; data: any }> {
      const k = getKey();
      if (!k) return { ok: false, status: 401, error: "Not signed in.", data: null };
      try {
        const r = await fetch(`/api/referrals.php?key=${encodeURIComponent(k)}&_t=${Date.now()}`, body
          ? { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) }
          : undefined);
        let data: any = null;
        try { data = await r.json(); } catch { data = null; }
        if (r.status === 401 || r.status === 403) {
          return { ok: false, status: r.status, error: data?.error || `Rewards API rejected the admin key (${r.status}).`, data: null };
        }
        if (!r.ok) {
          return { ok: false, status: r.status, error: data?.error || `Rewards server error (${r.status}).`, data: null };
        }
        if (!data?.ok) {
          return { ok: false, status: r.status, error: data?.error || "Rewards request failed.", data: null };
        }
        return { ok: true, status: r.status, error: "", data };
      } catch {
        return { ok: false, status: 0, error: "Network error talking to Rewards API.", data: null };
      }
    }

    function hydrateFromOrders(ledger: ReturnType<typeof emptyLedger>) {
      for (const o of allOrders) {
        const email = o.email || "";
        const loyaltyId = o.loyalty_id || "";
        if (email || loyaltyId) {
          upsertLoyalty(ledger, {
            email,
            loyalty_id: loyaltyId,
            own_code: o.own_referral_code,
            last_order_id: o.id,
            last_order_at: o.created_at,
            placed_count: undefined,
          });
        }
        const code = o.referral_code || o.referralCode;
        if (code) ensureCode(ledger, code);
      }
      const byKey = new Map<string, { placed: number; paid: number; spend: number; last: string; lastId: string; email: string; loyalty_id: string; own: string; history: { id: string; at: string; merch: number; status: string }[] }>();
      for (const o of allOrders) {
        const key = (o.email || o.loyalty_id || "").toLowerCase();
        if (!key) continue;
        const cur = byKey.get(key) || { placed: 0, paid: 0, spend: 0, last: "", lastId: "", email: o.email || "", loyalty_id: o.loyalty_id || "", own: o.own_referral_code || "", history: [] };
        cur.placed += 1;
        const merch = Number(o.total) || 0;
        cur.spend += merch;
        if (o.status === "paid" || o.status === "shipped") cur.paid += 1;
        if ((o.created_at || "") > cur.last) {
          cur.last = o.created_at || "";
          cur.lastId = o.id || "";
        }
        cur.history.push({ id: o.id || "", at: o.created_at || "", merch, status: o.status || "received" });
        byKey.set(key, cur);
      }
      for (const row of byKey.values()) {
        upsertLoyalty(ledger, {
          email: row.email,
          loyalty_id: row.loyalty_id,
          own_code: row.own,
          placed_count: row.placed,
          paid_count: row.paid,
          lifetime_spend: row.spend,
          last_order_id: row.lastId,
          last_order_at: row.last,
        });
        const found = ledger.loyalty.find(
          (r) => (row.loyalty_id && r.loyalty_id === row.loyalty_id) || (row.email && r.email === row.email),
        );
        if (found) found.order_history = row.history.slice(-20);
      }
      return ledger;
    }

    async function loadRewards() {
      usingLocal = false;
      const res = await apiRewards();
      let snap = res.ok ? res.data : null;
      if (!snap) {
        usingLocal = true;
        const local = hydrateFromOrders(loadLocalLedger());
        saveLocalLedger(local);
        snap = {
          ok: true,
          codes: Object.values(local.codes),
          loyalty: local.loyalty,
          events: [...local.events].reverse().slice(0, 200),
          updated_at: local.updated_at,
        };
        if (res.error) {
          const banner = document.getElementById("rewardsLocalBanner") as HTMLElement;
          if (banner) {
            banner.hidden = false;
            banner.textContent = `${res.error} Using this browser’s local ledger so you can still create codes. Export JSON as backup.`;
          }
        }
      } else {
        saveLocalLedger({
          version: 1,
          codes: Object.fromEntries((snap.codes || []).map((c: any) => [c.code, c])),
          events: snap.events || [],
          loyalty: snap.loyalty || [],
          updated_at: snap.updated_at,
        });
      }
      rewardsSnap = snap;
      const banner = document.getElementById("rewardsLocalBanner") as HTMLElement;
      if (banner && !usingLocal) banner.hidden = true;
      if (banner && usingLocal && !res.error) {
        banner.hidden = false;
        banner.textContent = "Using this browser’s local ledger (PHP API unreachable). Export JSON as backup. Order emails still hold referral/loyalty fields.";
      }
      renderRewards();
      renderOverview();
    }

    function statusChips(c: any) {
      const chips: string[] = [];
      if (c.active === false) chips.push(`<span class="chip inactive">Inactive</span>`);
      else chips.push(`<span class="chip available">Active</span>`);
      if ((Number(c.pending) || 0) > 0) chips.push(`<span class="chip pending">Pending</span>`);
      else if ((Number(c.available) || 0) > 0) chips.push(`<span class="chip available">Available</span>`);
      else if ((Number(c.redeemed) || 0) > 0) chips.push(`<span class="chip redeemed">Redeemed</span>`);
      return chips.join(" ");
    }

    function renderRewards() {
      const codes = rewardsSnap?.codes || [];
      const loyalty = rewardsSnap?.loyalty || [];
      const events = rewardsSnap?.events || [];
      const k = summarizeRewards({ codes, loyalty });
      document.getElementById("rewardsKpis")!.innerHTML = kpiHtml([
        { label: "Referral codes", value: String(k.totalCodes), hint: `${k.activeCodes} active` },
        { label: "Pending $25 credits", value: money(k.pending), hint: "Wait for paid", tone: "yellow" },
        { label: "Available credit", value: money(k.available), hint: "Can spend at checkout" },
        { label: "Redeemed", value: money(k.redeemed), hint: "Already used", tone: "red" },
        { label: "Active loyalty", value: String(k.loyaltyActive), hint: `${k.loyaltyCustomers} on file` },
        { label: "Referred orders", value: String(k.referredOrders), hint: "Lifetime" },
      ]);

      const q = ((document.getElementById("codeSearch") as HTMLInputElement)?.value || "").trim().toLowerCase();
      const filter = ((document.getElementById("codeFilter") as HTMLSelectElement)?.value || "active");
      const filtered = codes.filter((c: any) => {
        const hay = `${c.code || ""} ${c.owner_name || ""} ${c.owner_email || ""} ${c.note || ""}`.toLowerCase();
        if (q && !hay.includes(q)) return false;
        if (filter === "active") return c.active !== false;
        if (filter === "inactive") return c.active === false;
        if (filter === "pending") return (Number(c.pending) || 0) > 0;
        return true;
      });

      const body = document.getElementById("refTableBody")!;
      if (codes.length === 0) {
        body.innerHTML = `<tr><td colspan="8"><div class="empty"><strong>No referral codes yet.</strong><br/>Use the yellow <strong>Create referral code</strong> card above. Then copy <code>https://belgium420.com/?ref=CODE</code>. When a friend checks out with that link, $25 sits in Pending until you mark the order paid.</div></td></tr>`;
      } else if (filtered.length === 0) {
        body.innerHTML = `<tr><td colspan="8"><div class="empty">No codes match that search/filter.</div></td></tr>`;
      } else {
        body.innerHTML = filtered.map((c: any) => `
          <tr data-code="${escapeHtml(c.code)}" class="${c.active === false ? "is-inactive" : ""}">
            <td>
              <code>${escapeHtml(c.code)}</code>
              <div class="muted">${escapeHtml(c.owner_name || "—")}${c.owner_email ? " · " + escapeHtml(c.owner_email) : ""}${c.note ? "<br/>" + escapeHtml(c.note) : ""}</div>
            </td>
            <td>${statusChips(c)}</td>
            <td>${money(c.pending)}</td>
            <td>${money(c.available)}</td>
            <td>${money(c.redeemed)}</td>
            <td>${c.referred_orders || 0}</td>
            <td><span class="muted">${escapeHtml(relTime(c.updated_at || ""))}</span></td>
            <td>
              <div class="row-actions">
                <button type="button" class="btn btn-sm primary" data-act="copy">Copy share link</button>
                <button type="button" class="btn btn-sm" data-act="edit">Edit</button>
                ${(Number(c.pending) || 0) > 0 ? `<button type="button" class="btn btn-sm" data-act="clear">Mark paid / credit available</button>` : ""}
                ${(Number(c.available) || 0) > 0 ? `<button type="button" class="btn btn-sm" data-act="redeem">Mark redeemed</button>` : ""}
                <button type="button" class="btn btn-sm" data-act="adjust">Adjust balance</button>
                ${c.active === false
                  ? `<button type="button" class="btn btn-sm" data-act="activate">Reactivate</button>`
                  : `<button type="button" class="btn btn-sm danger" data-act="deactivate">Deactivate</button>`}
              </div>
            </td>
          </tr>
        `).join("");
        body.querySelectorAll("tr[data-code]").forEach((tr) => {
          const code = tr.getAttribute("data-code") || "";
          tr.querySelectorAll("button[data-act]").forEach((btn) => {
            btn.addEventListener("click", () => void rewardsAction(code, btn.getAttribute("data-act") || ""));
          });
        });
      }

      const lq = ((document.getElementById("loySearch") as HTMLInputElement)?.value || "").trim().toLowerCase();
      const loyFiltered = loyalty.filter((r: any) => {
        if (!lq) return true;
        const hay = `${r.email || ""} ${r.loyalty_id || ""} ${r.own_code || ""}`.toLowerCase();
        return hay.includes(lq);
      });
      const loyBody = document.getElementById("loyTableBody")!;
      if (loyalty.length === 0) {
        loyBody.innerHTML = `<tr><td colspan="6"><div class="empty"><strong>No loyalty customers yet.</strong><br/>They appear after checkout. Discount is 1% off per $100 lifetime merchandise spend, capped at 25%.</div></td></tr>`;
      } else if (loyFiltered.length === 0) {
        loyBody.innerHTML = `<tr><td colspan="6"><div class="empty">No customers match that search.</div></td></tr>`;
      } else {
        loyBody.innerHTML = loyFiltered.map((r: any) => {
          const hist = (r.order_history || []).slice(-5).map((h: any) => `${h.id || "?"} ${money(h.merch)} ${h.status || ""}`).join(" · ");
          return `
          <tr>
            <td>${escapeHtml(r.email || r.loyalty_id || "—")}<div class="muted">${escapeHtml(r.loyalty_id || "")}${r.own_code ? " · code " + escapeHtml(r.own_code) : ""}${hist ? "<br/>" + escapeHtml(hist) : ""}</div></td>
            <td>${money(r.lifetime_spend || 0)}</td>
            <td>${r.current_percent || 0}%</td>
            <td class="muted">${escapeHtml(r.next_reward || "")}</td>
            <td>${r.placed_count || 0}${r.paid_count ? ` <span class="muted">(${r.paid_count} paid)</span>` : ""}</td>
            <td>${escapeHtml(r.last_order_id || "—")}<div class="muted">${r.last_order_at ? escapeHtml(relTime(r.last_order_at)) : ""}</div></td>
          </tr>`;
