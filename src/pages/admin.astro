---
// /admin — CRM-style ops dashboard (Overview, Orders kanban, Rewards).
// Auth: simple password gate stored in sessionStorage. The same password is the
// admin key for the API. Shared-hosting-tier security — adequate for a small shop.
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ops — Belgium420</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --belgian-black: #050505;
      --belgian-yellow: #F5C400;
      --belgian-red: #E31C23;
      --asphalt: #141414;
      --surface: #1a1a1a;
      --concrete: #9A968C;
      --chalk: #F5F1E8;
      --ink: #050505;
      --line: rgba(245,241,232,0.1);
      --line-strong: rgba(245,241,232,0.2);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { min-height: 100vh; }
    body {
      font-family: 'Space Grotesk', system-ui, sans-serif;
      background: var(--belgian-black);
      color: var(--chalk);
      line-height: 1.5;
    }
    button, input, select, textarea { font: inherit; }
    [hidden] { display: none !important; }

    /* ============ LOGIN ============ */
    .login {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 2rem;
    }
    .login-box {
      width: 100%;
      max-width: 380px;
      padding: 2rem;
      background: var(--asphalt);
      border: 1px solid var(--line-strong);
    }
    .login-kicker {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--belgian-yellow);
      margin-bottom: 0.45rem;
    }
    .login-box h1 {
      font-family: 'Anton', sans-serif;
      font-size: 1.7rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.45rem;
    }
    .login-box p { font-size: 0.85rem; color: var(--concrete); margin-bottom: 1.25rem; }
    .login-box input {
      width: 100%;
      padding: 0.75rem;
      background: var(--belgian-black);
      color: var(--chalk);
      border: 1px solid var(--line-strong);
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.95rem;
      margin-bottom: 0.75rem;
    }
    .login-box input:focus { outline: none; border-color: var(--belgian-yellow); }
    .login-box button {
      width: 100%;
      padding: 0.75rem;
      background: var(--belgian-yellow);
      color: var(--ink);
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      border: none;
      cursor: pointer;
    }
    .login-box button:hover { background: var(--chalk); }
    .login-error {
      color: var(--belgian-red);
      font-size: 0.85rem;
      margin-bottom: 0.75rem;
      min-height: 1.2em;
    }

    /* ============ APP SHELL ============ */
    .app { min-height: 100vh; display: flex; flex-direction: column; }
    .app-bar {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.7rem 1.25rem;
      background: var(--asphalt);
      border-bottom: 1px solid var(--line);
      position: sticky;
      top: 0;
      z-index: 50;
      flex-wrap: wrap;
    }
    .brand {
      font-family: 'Anton', sans-serif;
      font-size: 1.15rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      white-space: nowrap;
    }
    .brand span { color: var(--belgian-yellow); }
    .app-nav {
      display: flex;
      gap: 0.3rem;
      flex: 1;
      min-width: 0;
      flex-wrap: wrap;
    }
    .app-tab {
      padding: 0.5rem 0.9rem;
      min-height: 44px;
      background: transparent;
      color: var(--concrete);
      border: 1px solid transparent;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      cursor: pointer;
      border-radius: 2px;
    }
    .app-tab:hover { color: var(--chalk); }
    .app-tab.is-on {
      background: var(--belgian-yellow);
      color: var(--ink);
    }
    .app-actions { display: flex; gap: 0.45rem; align-items: center; margin-left: auto; }
    .app-meta {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: var(--concrete);
      white-space: nowrap;
    }
    .btn {
      padding: 0.5rem 0.85rem;
      min-height: 44px;
      background: transparent;
      color: var(--chalk);
      border: 1px solid var(--line-strong);
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      cursor: pointer;
    }
    .btn:hover { border-color: var(--belgian-yellow); color: var(--belgian-yellow); }
    .btn.primary {
      background: var(--belgian-yellow);
      color: var(--ink);
      border-color: var(--belgian-yellow);
      font-weight: 700;
    }
    .btn.primary:hover { background: var(--chalk); border-color: var(--chalk); color: var(--ink); }
    .btn.danger { color: var(--belgian-red); border-color: rgba(227,28,35,0.45); }
    .btn.danger:hover { background: var(--belgian-red); color: var(--chalk); }
    .btn:disabled { opacity: 0.45; cursor: not-allowed; }
    .btn-sm { padding: 0.28rem 0.5rem; font-size: 0.64rem; }

    .app-main {
      flex: 1;
      width: 100%;
      max-width: 1440px;
      margin: 0 auto;
      padding: 1.25rem 1.5rem 3rem;
    }
    .panel-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1.1rem;
    }
    .panel-head h1 {
      font-family: 'Anton', sans-serif;
      font-size: clamp(1.4rem, 3vw, 1.9rem);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .panel-head h1 em {
      font-style: normal;
      color: var(--belgian-yellow);
    }
    .panel-lead {
      font-size: 0.85rem;
      color: var(--concrete);
      max-width: 42rem;
    }

    /* ============ KPI ============ */
    .kpi-strip {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
      gap: 0.7rem;
      margin-bottom: 1.25rem;
    }
    .kpi {
      background: var(--asphalt);
      border: 1px solid var(--line);
      padding: 0.85rem 0.95rem;
      min-height: 5.2rem;
    }
    .kpi-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.62rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--concrete);
      margin-bottom: 0.35rem;
    }
    .kpi-value {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--chalk);
    }
    .kpi-value.yellow { color: var(--belgian-yellow); }
    .kpi-value.red { color: var(--belgian-red); }
    .kpi-hint { font-size: 0.7rem; color: var(--concrete); margin-top: 0.2rem; }

    .grid-2 {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 1rem;
    }
    .card-block {
      background: var(--asphalt);
      border: 1px solid var(--line);
      padding: 1rem;
    }
    .card-block h2 {
      font-family: 'Anton', sans-serif;
      font-size: 0.95rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--belgian-yellow);
      margin-bottom: 0.75rem;
    }
    .attn-row, .evt-row {
      display: flex;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.55rem 0;
      border-bottom: 1px solid var(--line);
      font-size: 0.8rem;
    }
    .attn-row:last-child, .evt-row:last-child { border-bottom: none; }
    .empty {
      color: var(--concrete);
      font-size: 0.85rem;
      padding: 1.25rem 0.5rem;
      line-height: 1.55;
    }
    .empty strong { color: var(--chalk); font-weight: 600; }
    .how {
      background: var(--surface);
      border: 1px solid var(--line);
      padding: 0.85rem 1rem;
      font-size: 0.82rem;
      color: var(--concrete);
      margin-bottom: 1rem;
      line-height: 1.55;
    }
    .how code { color: var(--belgian-yellow); font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; }

    .create-card {
      background: var(--asphalt);
      border: 2px solid var(--belgian-yellow);
      padding: 1.1rem 1.15rem 1.2rem;
      margin-bottom: 1.25rem;
    }
    .create-card h2 {
      font-family: 'Anton', sans-serif;
      font-size: 1.15rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--belgian-yellow);
      margin-bottom: 0.3rem;
    }
    .create-card p { font-size: 0.85rem; color: var(--concrete); margin-bottom: 0.75rem; }
    .create-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) repeat(3, minmax(0, 1fr));
      gap: 0.65rem 0.7rem;
      margin-bottom: 0.75rem;
    }
    .create-card .field { margin-bottom: 0; min-width: 0; }
    .code-row { display: flex; gap: 0.4rem; min-width: 0; }
    .code-row .field-input { flex: 1; min-width: 0; margin-bottom: 0; }
    .code-row .btn { flex: 0 0 auto; white-space: nowrap; }
    .create-submit {
      min-height: 48px;
      min-width: 220px;
      font-size: 0.9rem;
      width: auto;
    }
    .form-error {
      color: var(--belgian-red);
      font-size: 0.85rem;
      margin: 0 0 0.7rem;
    }
    .create-success {
      margin-top: 0.9rem;
      padding: 0.9rem;
      border: 1px solid var(--belgian-yellow);
      background: var(--belgian-black);
    }
    .create-success strong { color: var(--chalk); }
    .create-success code {
      display: block;
      color: var(--belgian-yellow);
      word-break: break-all;
      margin: 0.4rem 0 0.75rem;
      font-size: 0.85rem;
      font-family: 'JetBrains Mono', monospace;
    }
    .create-success .btn { width: 100%; }
    .create-card--mini .btn { width: auto; min-width: 220px; }
    .banner {
      font-size: 0.8rem;
      padding: 0.65rem 0.85rem;
      border: 1px solid var(--belgian-yellow);
      color: var(--belgian-yellow);
      margin-bottom: 1rem;
    }

    /* ============ KANBAN ============ */
    .kanban {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.9rem;
    }
    .col {
      background: var(--asphalt);
      border: 1px solid var(--line);
      padding: 0.85rem;
      min-height: 58vh;
    }
    .col-received { border-top: 3px solid var(--chalk); }
    .col-paid { border-top: 3px solid var(--belgian-yellow); }
    .col-shipped { border-top: 3px solid var(--belgian-red); }
    .col-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.85rem;
      padding-bottom: 0.55rem;
      border-bottom: 1px solid var(--line);
    }
    .col-title {
      font-family: 'Anton', sans-serif;
      font-size: 0.95rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .col-received .col-title { color: var(--chalk); }
    .col-paid .col-title { color: var(--belgian-yellow); }
    .col-shipped .col-title { color: var(--belgian-red); }
    .col-count {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
      color: var(--concrete);
      background: var(--belgian-black);
      padding: 0.15rem 0.5rem;
    }
    .col-empty { color: var(--concrete); font-size: 0.82rem; padding: 1.5rem 0.4rem; text-align: center; line-height: 1.5; }

    .order-card {
      background: var(--belgian-black);
      border: 1px solid var(--line);
      padding: 0.8rem;
      margin-bottom: 0.65rem;
      cursor: pointer;
      transition: border-color 0.15s, transform 0.1s;
    }
    .order-card:hover { border-color: var(--belgian-yellow); transform: translateY(-1px); }
    .card-top {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
      align-items: baseline;
      margin-bottom: 0.3rem;
    }
    .card-id {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.66rem;
      color: var(--belgian-yellow);
    }
    .card-when { font-size: 0.66rem; color: var(--concrete); }
    .card-name {
      font-family: 'Anton', sans-serif;
      font-size: 0.92rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 0.2rem;
    }
    .card-meta { font-size: 0.74rem; color: var(--concrete); line-height: 1.4; }
    .card-items { font-size: 0.68rem; color: var(--concrete); margin-top: 0.35rem; line-height: 1.4; }
    .card-foot {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.4rem;
      margin-top: 0.5rem;
      flex-wrap: wrap;
    }
    .card-total {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--belgian-yellow);
    }
    .badges { display: flex; flex-wrap: wrap; gap: 0.3rem; }

    /* ============ CHIPS ============ */
    .chip {
      display: inline-flex;
      align-items: center;
      padding: 0.12rem 0.45rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.62rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border: 1px solid currentColor;
      white-space: nowrap;
    }
    .chip.pending { color: var(--belgian-yellow); }
    .chip.available { color: var(--chalk); }
    .chip.redeemed { color: var(--belgian-red); }
    .chip.inactive { color: var(--concrete); }
    .chip.received { color: var(--chalk); }
    .chip.paid { color: var(--belgian-yellow); }
    .chip.shipped { color: var(--belgian-red); }
    .chip.loyalty { color: var(--belgian-red); }

    /* ============ TABLES / TOOLBARS ============ */
    .toolbar {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      align-items: center;
      margin-bottom: 0.9rem;
    }
    .search {
      flex: 1;
      min-width: 180px;
      padding: 0.5rem 0.7rem;
      background: var(--belgian-black);
      color: var(--chalk);
      border: 1px solid var(--line-strong);
      font-size: 0.85rem;
    }
    .search:focus { outline: none; border-color: var(--belgian-yellow); }
    .filter {
      padding: 0.5rem 0.6rem;
      background: var(--belgian-black);
      color: var(--chalk);
      border: 1px solid var(--line-strong);
      font-size: 0.8rem;
    }
    .section-h {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.75rem;
      margin: 1.4rem 0 0.7rem;
    }
    .section-h h2 {
      font-family: 'Anton', sans-serif;
      font-size: 1.05rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--belgian-yellow);
    }
    .table-wrap { overflow-x: auto; border: 1px solid var(--line); background: var(--asphalt); }
    .crm-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8rem;
    }
    .crm-table th {
      text-align: left;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.64rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--concrete);
      padding: 0.55rem 0.7rem;
      border-bottom: 1px solid var(--line);
      white-space: nowrap;
      background: var(--surface);
    }
    .crm-table td {
      padding: 0.7rem;
      border-bottom: 1px solid rgba(245,241,232,0.06);
      vertical-align: top;
    }
    .crm-table tr:hover td { background: rgba(245,196,0,0.04); }
    .crm-table code { color: var(--belgian-yellow); font-family: 'JetBrains Mono', monospace; }
    .muted { color: var(--concrete); font-size: 0.72rem; }
    .row-actions { display: flex; flex-wrap: wrap; gap: 0.3rem; }
    .evt-list { font-size: 0.75rem; color: var(--concrete); max-height: 280px; overflow: auto; }
    .evt-list div { padding: 0.4rem 0; border-bottom: 1px solid var(--line); }
    .file-btn { display: inline-flex; align-items: center; }
    .file-btn input { display: none; }

    /* ============ MODALS ============ */
    .modal-bg {
      position: fixed; inset: 0; z-index: 9000;
      background: rgba(5,5,5,0.78);
      display: flex; align-items: center; justify-content: center;
      padding: 1.25rem;
    }
    .modal {
      background: var(--asphalt);
      border: 1px solid var(--belgian-yellow);
      width: 100%;
      max-width: 640px;
      max-height: 90vh;
      overflow-y: auto;
      padding: 1.5rem;
    }
    .modal.narrow { max-width: 440px; }
    .modal-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.1rem;
      padding-bottom: 0.7rem;
      border-bottom: 1px solid var(--line);
    }
    .modal-head h2 {
      font-family: 'Anton', sans-serif;
      font-size: 1.15rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .modal-close {
      background: transparent;
      border: none;
      color: var(--chalk);
      font-size: 1.6rem;
      line-height: 1;
      cursor: pointer;
    }
    .modal-section { margin-bottom: 1.15rem; }
    .modal-section h3 {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--belgian-yellow);
      margin-bottom: 0.45rem;
    }
    .modal-row { font-size: 0.85rem; margin-bottom: 0.25rem; }
    .modal-row strong { color: var(--concrete); font-weight: 500; margin-right: 0.5rem; }
    .modal-items { padding: 0; }
    .modal-items li {
      list-style: none;
      padding: 0.4rem 0;
      border-bottom: 1px solid rgba(245,241,232,0.06);
      font-size: 0.85rem;
      display: flex;
      justify-content: space-between;
    }
    .modal-items li:last-child { border-bottom: none; }
    .modal-actions { display: flex; gap: 0.5rem; margin-top: 1rem; flex-wrap: wrap; }
    .modal-btn {
      flex: 1;
      min-width: 110px;
      padding: 0.7rem;
      background: var(--belgian-yellow);
      color: var(--ink);
      font-weight: 700;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border: none;
      cursor: pointer;
    }
    .modal-btn:hover { background: var(--chalk); }
    .modal-btn.secondary { background: transparent; color: var(--chalk); border: 1px solid var(--line-strong); }
    .modal-btn.secondary:hover { border-color: var(--belgian-yellow); color: var(--belgian-yellow); }
    .modal-btn.danger { background: var(--belgian-red); color: var(--chalk); }
    .modal-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .modal-track, .field-input {
      width: 100%;
      padding: 0.65rem;
      background: var(--belgian-black);
      color: var(--chalk);
      border: 1px solid var(--line-strong);
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.88rem;
      margin-bottom: 0.45rem;
    }
    .modal-track:focus, .field-input:focus { outline: none; border-color: var(--belgian-yellow); }
    .modal-label, .field-label {
      display: block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--concrete);
      margin-bottom: 0.35rem;
    }
    .field { margin-bottom: 0.75rem; }
    .status-pill {
      display: inline-block;
      padding: 0.2rem 0.55rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border: 1px solid currentColor;
      vertical-align: middle;
      margin-left: 0.4rem;
    }
    .status-pill.received { color: var(--chalk); }
    .status-pill.paid { color: var(--belgian-yellow); }
    .status-pill.shipped { color: var(--belgian-red); }

    .toast {
      position: fixed;
      bottom: 1.25rem;
      right: 1.25rem;
      z-index: 9500;
      background: var(--belgian-yellow);
      color: var(--ink);
      padding: 0.65rem 0.95rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      box-shadow: 0 8px 24px rgba(0,0,0,0.4);
      max-width: calc(100vw - 1.5rem);
    }

    @media (max-width: 960px) {
      html, body { overflow-x: hidden; }
      .grid-2 { grid-template-columns: 1fr; }
      .kanban { grid-template-columns: 1fr; }
      .col { min-height: 0; }
      .app-bar { padding: 0.55rem 0.75rem; }
      .app-nav {
        order: 3;
        width: 100%;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        overflow: visible;
      }
      .app-tab {
        width: 100%;
        text-align: center;
        border: 1px solid var(--line-strong);
        padding: 0.55rem 0.2rem;
      }
      .app-actions { margin-left: 0; width: 100%; justify-content: space-between; }
      .app-main { padding: 1rem 0.85rem 2.5rem; max-width: 100%; }
      .create-grid { grid-template-columns: 1fr; }
      .code-row { flex-direction: column; }
      .code-row .btn, .create-submit, .create-card--mini .btn { width: 100%; min-height: 48px; }
      .create-card .field-input { min-height: 48px; }
      .search, .filter { min-height: 44px; width: 100%; }
      .toolbar { flex-direction: column; align-items: stretch; }
      .toast { left: 0.75rem; right: 0.75rem; bottom: 0.75rem; }
      .panel-head .btn { width: 100%; }
    }
  </style>
</head>
<body>

  <div class="login" id="loginView">
    <form class="login-box" id="loginForm">
      <div class="login-kicker">Belgium420</div>
      <h1>Ops desk</h1>
      <p>Orders, referral credits, and loyalty — same admin key as always.</p>
      <div class="login-error" id="loginError"></div>
      <input type="password" id="loginKey" placeholder="Admin key" autocomplete="current-password" />
      <button type="submit">Sign in</button>
    </form>
  </div>

  <div class="app" id="kanbanView" hidden>
    <header class="app-bar">
      <div class="brand">Belgium420 <span>Ops</span></div>
      <nav class="app-nav" role="tablist" aria-label="Admin sections">
        <button type="button" class="app-tab is-on" data-tab="overview" id="tabOverview">Overview</button>
        <button type="button" class="app-tab" data-tab="orders" id="tabOrders">Orders</button>
        <button type="button" class="app-tab" data-tab="rewards" id="tabRewards">Rewards</button>
      </nav>
      <div class="app-actions">
        <span class="app-meta" id="kanbanStats"></span>
        <button type="button" class="btn" id="refreshBtn">Refresh</button>
        <button type="button" class="btn danger" id="logoutBtn">Sign out</button>
      </div>
    </header>

    <main class="app-main">
      <section id="overviewPanel">
        <div class="panel-head">
          <div>
            <h1>Overview</h1>
            <p class="panel-lead">Today’s pipeline, referral money, and the last few credit events. Open Orders to move cards; Rewards to issue codes.</p>
          </div>
          <button type="button" class="btn primary" id="overviewCreateBtn">Create referral code</button>
        </div>
        <div class="kpi-strip" id="overviewOrderKpis"></div>
        <div class="kpi-strip" id="overviewRewardKpis"></div>
        <div class="grid-2">
          <div class="card-block">
            <h2>Pending credits</h2>
            <p class="muted" style="margin-bottom:0.6rem">$25 waiting until you mark the referred order Paid (or Clear pending on Rewards).</p>
            <div id="overviewPending"></div>
          </div>
          <div class="card-block">
            <h2>Recent referral events</h2>
            <div class="evt-list" id="overviewEvents"></div>
          </div>
        </div>
      </section>

      <section id="ordersPanel" hidden>
        <div class="panel-head">
          <div>
            <h1>Orders <em id="kanbanCount">(0)</em></h1>
            <p class="panel-lead">Received → Paid → Shipped. Marking Paid also clears a $25 referral credit for that order when one is pending.</p>
          </div>
        </div>
        <div class="kanban">
          <div class="col col-received" data-col="received">
            <div class="col-head"><div class="col-title">Received</div><div class="col-count" id="countReceived">0</div></div>
            <div class="col-list" id="listReceived"></div>
          </div>
          <div class="col col-paid" data-col="paid">
            <div class="col-head"><div class="col-title">Paid</div><div class="col-count" id="countPaid">0</div></div>
            <div class="col-list" id="listPaid"></div>
          </div>
          <div class="col col-shipped" data-col="shipped">
            <div class="col-head"><div class="col-title">Shipped</div><div class="col-count" id="countShipped">0</div></div>
            <div class="col-list" id="listShipped"></div>
          </div>
        </div>
      </section>

      <section class="rewards-panel" id="rewardsPanel" hidden>
        <div class="panel-head">
          <div>
            <h1>Rewards</h1>
            <p class="panel-lead">Create share links, watch pending $25 credits, and keep loyalty spend honest. Math is unchanged: 1% off per $100 merchandise, cap 25%.</p>
          </div>
        </div>
        <div class="create-card" id="createCodeCard">
          <h2>Create referral code</h2>
          <p>Give this to one person. They share <code>https://belgium420.com/?ref=CODE</code> with friends. You can type a code or tap Generate, then edit it before saving.</p>
          <form id="addCodeForm">
            <div class="create-grid">
              <div class="field">
                <label class="field-label" for="newCode">Code</label>
                <div class="code-row">
                  <input class="field-input" type="text" id="newCode" name="code" maxlength="24" required placeholder="ALICE" autocomplete="off" autocapitalize="characters" />
                  <button type="button" class="btn" id="generateCodeBtn">Generate</button>
                </div>
              </div>
              <div class="field">
                <label class="field-label" for="newCodeName">Owner name</label>
                <input class="field-input" type="text" id="newCodeName" name="owner_name" maxlength="80" placeholder="Alice" autocomplete="name" />
              </div>
              <div class="field">
                <label class="field-label" for="newCodeEmail">Owner email</label>
                <input class="field-input" type="email" id="newCodeEmail" name="owner_email" placeholder="alice@email.com" autocomplete="email" />
              </div>
              <div class="field">
                <label class="field-label" for="newCodeNote">Notes</label>
                <input class="field-input" type="text" id="newCodeNote" name="note" maxlength="200" placeholder="Instagram / wholesale / VIP" />
              </div>
            </div>
            <div class="form-error" id="addCodeError" hidden></div>
            <button type="submit" class="btn primary create-submit" id="addCodeSubmit">Create referral code</button>
          </form>
          <div class="create-success" id="addCodeSuccess" hidden>
            <strong>Code ready.</strong> Send this link:
            <code id="addCodeShareUrl"></code>
            <button type="button" class="btn primary" id="addCodeCopyBtn">Copy link</button>
          </div>
        </div>
        <div class="banner" id="rewardsLocalBanner" hidden>Using this browser’s local ledger (PHP API unreachable). Export JSON as backup. Order emails still hold referral/loyalty fields.</div>
        <div class="kpi-strip" id="rewardsKpis"></div>
        <div class="how">
          A friend shops with <code>?ref=CODE</code> → the code gets <strong>$25 pending</strong>.
          When you <strong>Mark as Paid</strong> on the order (or Mark paid / credit available here), that $25 becomes <strong>available</strong>.
          Checkout “store credit / referral code” spends available balance. Reject self-referrals.
          Share link: <code>https://belgium420.com/?ref=CODE</code>.
        </div>

        <div class="section-h">
          <h2>Referral codes</h2>
        </div>
        <div class="toolbar">
          <input type="search" class="search" id="codeSearch" placeholder="Search code, name, or email" />
          <select class="filter" id="codeFilter" aria-label="Filter codes">
            <option value="active">Active</option>
            <option value="pending">Has pending $</option>
            <option value="inactive">Inactive</option>
            <option value="all">All codes</option>
          </select>
          <button type="button" class="btn" id="rewardsRefresh">Refresh ledger</button>
          <button type="button" class="btn" id="rewardsExport">Export JSON</button>
          <button type="button" class="btn" id="rewardsExportCsv">Export CSV</button>
          <label class="btn file-btn">Import JSON<input type="file" id="rewardsImport" accept="application/json,.json" /></label>
        </div>
        <div class="table-wrap">
          <table class="crm-table" id="refTable">
            <thead>
              <tr>
                <th>Code / owner</th>
                <th>Status</th>
                <th>Pending</th>
                <th>Available</th>
                <th>Redeemed</th>
                <th>Referred</th>
                <th>Updated</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="refTableBody"></tbody>
          </table>
        </div>

        <div class="section-h">
          <h2>Loyalty customers</h2>
        </div>
        <div class="toolbar">
          <input type="search" class="search" id="loySearch" placeholder="Search email or loyalty ID" />
        </div>
        <div class="table-wrap">
          <table class="crm-table" id="loyTable">
            <thead>
              <tr>
                <th>Customer</th>
                <th>Lifetime merch</th>
                <th>% off</th>
                <th>Next</th>
                <th>Orders</th>
                <th>Last order</th>
              </tr>
            </thead>
            <tbody id="loyTableBody"></tbody>
          </table>
        </div>

        <div class="section-h">
          <h2>Recent events</h2>
        </div>
        <div class="card-block">
          <div class="evt-list" id="evtList"></div>
        </div>
      </section>
    </main>
  </div>

  <div class="modal-bg" id="modal" hidden>
    <div class="modal" id="modalBody"></div>
  </div>
  <div class="modal-bg" id="dialog" hidden>
    <div class="modal narrow" id="dialogBody"></div>
  </div>
  <div class="toast" id="toast" hidden></div>

  <script>
    import {
      emptyLedger,
      loadLocalLedger,
      saveLocalLedger,
      mergeLedgers,
      ledgerToCsv,
      markCleared,
      redeemCredit,
      adjustAvailable,
      ensureCode,
      upsertLoyalty,
      updateCodeMeta,
      setCodeActive,
      summarizeRewards,
    } from "../lib/rewards-ledger.js";
    import { shareUrlForCode, codeFromName, normalizeReferralCode } from "../lib/rewards.js";

    const SESSION_KEY = "b420_admin_key";

    const loginView = document.getElementById("loginView") as HTMLDivElement;
    const kanbanView = document.getElementById("kanbanView") as HTMLDivElement;
    const loginForm = document.getElementById("loginForm") as HTMLFormElement;
    const loginKey = document.getElementById("loginKey") as HTMLInputElement;
    const loginError = document.getElementById("loginError") as HTMLDivElement;
    const refreshBtn = document.getElementById("refreshBtn") as HTMLButtonElement;
    const logoutBtn = document.getElementById("logoutBtn") as HTMLButtonElement;
    const kanbanCount = document.getElementById("kanbanCount")!;
    const kanbanStats = document.getElementById("kanbanStats")!;
    const modal = document.getElementById("modal") as HTMLDivElement;
    const modalBody = document.getElementById("modalBody") as HTMLDivElement;
    const dialog = document.getElementById("dialog") as HTMLDivElement;
    const dialogBody = document.getElementById("dialogBody") as HTMLDivElement;
    const toastEl = document.getElementById("toast") as HTMLDivElement;

    const overviewPanel = document.getElementById("overviewPanel") as HTMLElement;
    const ordersPanel = document.getElementById("ordersPanel") as HTMLElement;
    const rewardsPanel = document.getElementById("rewardsPanel") as HTMLElement;
    const tabOverview = document.getElementById("tabOverview") as HTMLButtonElement;
    const tabOrders = document.getElementById("tabOrders") as HTMLButtonElement;
    const tabRewards = document.getElementById("tabRewards") as HTMLButtonElement;

    let allOrders: any[] = [];
    let currentTab: "overview" | "orders" | "rewards" = "overview";
    let toastTimer = 0;
    let rewardsSnap: any = null;
    let usingLocal = false;
    let dialogResolve: ((v: any) => void) | null = null;

    function getKey(): string | null {
      return sessionStorage.getItem(SESSION_KEY);
    }
    function setKey(k: string) { sessionStorage.setItem(SESSION_KEY, k); }
    function clearKey() { sessionStorage.removeItem(SESSION_KEY); }

    function showLogin() {
      loginView.hidden = false;
      kanbanView.hidden = true;
    }
    function showKanban() {
      loginView.hidden = true;
      kanbanView.hidden = false;
      const hash = (location.hash || "").replace("#", "");
      if (hash === "orders" || hash === "rewards" || hash === "overview") currentTab = hash;
      showTab(currentTab);
      void loadOrders();
      void loadRewards();
    }

    function escapeHtml(s: string) {
      return String(s ?? "").replace(/[&<>"']/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!),
      );
    }
    function money(n: number) { return "$" + (Number(n) || 0).toFixed(2); }

    function relTime(iso: string) {
      if (!iso) return "—";
      const t = new Date(iso).getTime();
      if (!Number.isFinite(t)) return "—";
      const m = Math.floor((Date.now() - t) / 60000);
      if (m < 1) return "just now";
      if (m < 60) return `${m}m ago`;
      const h = Math.floor(m / 60);
      if (h < 24) return `${h}h ago`;
      const d = Math.floor(h / 24);
      if (d < 7) return `${d}d ago`;
      return new Date(iso).toLocaleDateString();
    }
    function isToday(iso: string) {
      if (!iso) return false;
      const d = new Date(iso);
      const n = new Date();
      return d.getFullYear() === n.getFullYear() && d.getMonth() === n.getMonth() && d.getDate() === n.getDate();
    }

    function toast(msg: string) {
      toastEl.hidden = false;
      toastEl.textContent = msg;
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => { toastEl.hidden = true; }, 2400);
    }

    function showLoginError(msg: string) {
      loginError.textContent = msg;
      loginError.style.minHeight = "1.2em";
    }
    function clearLoginError() {
      loginError.textContent = "";
    }

    loginForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearLoginError();
      const k = loginKey.value.trim();
      if (!k) {
        showLoginError("Enter your admin key.");
        return;
      }
      try {
        const r = await fetch(`/api/orders.php?key=${encodeURIComponent(k)}`);
        if (!r.ok) {
          showLoginError("Wrong key. Try again.");
          return;
        }
        setKey(k);
        showKanban();
      } catch (err) {
        showLoginError("Network error. Try again.");
      }
    });

    logoutBtn.addEventListener("click", () => {
      clearKey();
      showLogin();
    });
    refreshBtn.addEventListener("click", () => {
      void loadOrders();
      void loadRewards();
    });

    async function loadOrders() {
      const k = getKey();
      if (!k) { showLogin(); return; }
      try {
        const r = await fetch(`/api/orders.php?key=${encodeURIComponent(k)}&_t=${Date.now()}`);
        if (r.status === 401) {
          clearKey();
          showLogin();
          return;
        }
        const data = await r.json();
        if (!data.ok) {
          kanbanStats.textContent = "Failed to load orders.";
          return;
        }
        allOrders = data.orders || [];
        render();
        renderOverview();
      } catch (err) {
        kanbanStats.textContent = "Network error.";
      }
    }

    function orderCols() {
      const cols: Record<string, any[]> = { received: [], paid: [], shipped: [] };
      for (const o of allOrders) {
        const s = o.status || "received";
        if (!cols[s]) cols[s] = [];
        cols[s].push(o);
      }
      return cols;
    }

    function render() {
      const cols = orderCols();
      (["received", "paid", "shipped"] as const).forEach((s) => {
        const list = document.getElementById("list" + s[0].toUpperCase() + s.slice(1))!;
        const counter = document.getElementById("count" + s[0].toUpperCase() + s.slice(1))!;
        counter.textContent = String(cols[s].length);
        if (cols[s].length === 0) {
          const hint = s === "received"
            ? "No new checkouts. Orders land here when a customer submits the form."
            : s === "paid"
              ? "Nothing waiting to ship. Mark Received cards Paid after cash/Zelle clears."
              : "No shipped orders yet.";
          list.innerHTML = `<div class="col-empty">${hint}</div>`;
          return;
        }
        list.innerHTML = "";
        for (const o of cols[s]) {
          const card = document.createElement("div");
          card.className = "order-card";
          card.dataset.id = o.id;
          const items = (o.items || []).map((i: any) => `${escapeHtml(i.name)} (${money(i.price)})`).join(" · ");
          const creditStatus = o.referrer_credit_status || (o.referrer_credit_pending ? "pending" : "");
          card.innerHTML = `
            <div class="card-top">
              <div class="card-id">${escapeHtml(o.id || "")}</div>
              <div class="card-when">${escapeHtml(relTime(o.created_at || o.paid_at || o.shipped_at || ""))}</div>
            </div>
            <div class="card-name">${escapeHtml(o.name || "")}</div>
            <div class="card-meta">
              ${escapeHtml(o.city || "")}${o.city || o.state ? ", " : ""}${escapeHtml(o.state || "")}<br/>
              ${escapeHtml(o.email || "")}
              ${o.tracking ? `<br/>Tracking: <strong>${escapeHtml(o.tracking)}</strong>` : ""}
            </div>
            <div class="card-items">${items}</div>
            <div class="card-foot">
              <div class="card-total">${money(o.final_total ?? o.total)}${o.discount_percent > 0 ? ` <span style="color:var(--belgian-red);font-size:0.72rem">−${Math.round(o.discount_percent * 100)}%</span>` : ""}</div>
              <div class="badges">
                ${o.referral_code ? `<span class="chip ${escapeHtml(creditStatus === "available" || creditStatus === "cleared" ? "available" : creditStatus === "redeemed" ? "redeemed" : "pending")}">Ref ${escapeHtml(o.referral_code)}${o.self_referral_blocked ? " · self" : creditStatus ? " · " + escapeHtml(creditStatus) : ""}</span>` : ""}
                ${o.loyalty_percent > 0 ? `<span class="chip loyalty">Loyalty ${Math.round(o.loyalty_percent * 100)}%</span>` : ""}
              </div>
            </div>
          `;
          card.addEventListener("click", () => openModal(o));
          list.appendChild(card);
        }
      });
      kanbanCount.textContent = `(${allOrders.length})`;
      const totalValue = allOrders.reduce((sum: number, o: any) => sum + (o.final_total ?? o.total ?? 0), 0);
      kanbanStats.textContent = `${allOrders.length} orders · ${money(totalValue)}`;
    }

    function kpiHtml(items: { label: string; value: string; hint?: string; tone?: string }[]) {
      return items.map((k) => `
        <div class="kpi">
          <div class="kpi-label">${escapeHtml(k.label)}</div>
          <div class="kpi-value${k.tone ? " " + k.tone : ""}">${escapeHtml(k.value)}</div>
          ${k.hint ? `<div class="kpi-hint">${escapeHtml(k.hint)}</div>` : ""}
        </div>
      `).join("");
    }

    function renderOverview() {
      const cols = orderCols();
      const today = allOrders.filter((o) => isToday(o.created_at)).length;
      const open = (cols.received?.length || 0) + (cols.paid?.length || 0);
      const totalValue = allOrders.reduce((sum: number, o: any) => sum + (o.final_total ?? o.total ?? 0), 0);
      document.getElementById("overviewOrderKpis")!.innerHTML = kpiHtml([
        { label: "Today", value: String(today), hint: "Placed today" },
        { label: "Received", value: String(cols.received?.length || 0), hint: "Awaiting payment" },
        { label: "Paid", value: String(cols.paid?.length || 0), hint: "Ready to ship", tone: "yellow" },
        { label: "Shipped", value: String(cols.shipped?.length || 0), hint: "Out the door", tone: "red" },
        { label: "Open", value: String(open), hint: "Received + paid" },
        { label: "Pipeline $", value: money(totalValue), hint: "All statuses" },
      ]);

      const k = summarizeRewards(rewardsSnap || { codes: [], loyalty: [] });
      document.getElementById("overviewRewardKpis")!.innerHTML = kpiHtml([
        { label: "Referral codes", value: String(k.totalCodes), hint: `${k.activeCodes} active` },
        { label: "Pending credits", value: money(k.pending), hint: "Until marked paid", tone: "yellow" },
        { label: "Available credit", value: money(k.available), hint: "Ready at checkout" },
        { label: "Redeemed", value: money(k.redeemed), hint: "Already spent", tone: "red" },
        { label: "Loyalty customers", value: String(k.loyaltyActive), hint: "With spend on file" },
        { label: "Referred orders", value: String(k.referredOrders), hint: "Lifetime" },
      ]);

      const codes = rewardsSnap?.codes || [];
      const pending = codes.filter((c: any) => (Number(c.pending) || 0) > 0);
      const pendingEl = document.getElementById("overviewPending")!;
      if (pending.length === 0) {
        pendingEl.innerHTML = `<div class="empty">No pending $25 credits. When a referred order comes in, it shows here until you mark that order <strong>Paid</strong>.</div>`;
      } else {
        pendingEl.innerHTML = pending.map((c: any) => `
          <div class="attn-row">
            <div>
              <code>${escapeHtml(c.code)}</code>
              <div class="muted">${escapeHtml(c.owner_name || c.owner_email || "No owner yet")}</div>
            </div>
            <div>
              <span class="chip pending">${money(c.pending)} pending</span>
            </div>
          </div>
        `).join("");
      }

      const events = rewardsSnap?.events || [];
      const evtEl = document.getElementById("overviewEvents")!;
      evtEl.innerHTML = events.length
        ? events.slice(0, 8).map((e: any) => `
            <div class="evt-row">
              <div><strong>${escapeHtml(e.type)}</strong> · ${escapeHtml(e.code)} ${e.order_id ? "· " + escapeHtml(e.order_id) : ""}</div>
              <div>${money(e.amount)} · ${escapeHtml(relTime(e.at || ""))}</div>
            </div>
          `).join("")
        : `<div class="empty">No referral events yet. They appear when a code earns, clears, or spends credit.</div>`;
    }

    function openModal(o: any) {
      const itemsHtml = (o.items || []).map((i: any) => `
        <li>
          <span>${escapeHtml(i.name)} <small style="color:var(--concrete)">· Batch ${escapeHtml(i.batch || "")}</small></span>
          <span style="font-family:'JetBrains Mono',monospace;color:var(--belgian-yellow)">${money(i.price)}</span>
        </li>
      `).join("");
      const pays = (o.payments || []).join(", ") || "(none selected)";
      const tracking = o.tracking || "";
      const status = o.status || "received";
      const paidAt = o.paid_at ? new Date(o.paid_at).toLocaleString() : "—";
      const shippedAt = o.shipped_at ? new Date(o.shipped_at).toLocaleString() : "—";

      modalBody.innerHTML = `
        <div class="modal-head">
          <h2>${escapeHtml(o.id || "")} <span class="status-pill ${status}">${status}</span></h2>
          <button type="button" class="modal-close" data-modal-close>&times;</button>
        </div>

        <div class="modal-section">
          <h3>Customer</h3>
          <div class="modal-row"><strong>Name:</strong>${escapeHtml(o.name || "")}</div>
          <div class="modal-row"><strong>Email:</strong><a href="mailto:${escapeHtml(o.email || "")}" style="color:var(--belgian-yellow)">${escapeHtml(o.email || "")}</a></div>
          <div class="modal-row"><strong>Phone:</strong>${escapeHtml(o.phone || "—")}</div>
          <div class="modal-row"><strong>Ship to:</strong>${escapeHtml(o.address1 || "")} ${escapeHtml(o.address2 || "")}, ${escapeHtml(o.city || "")}, ${escapeHtml(o.state || "")} ${escapeHtml(o.zip || "")}</div>
          <div class="modal-row"><strong>Payment:</strong>${escapeHtml(pays)}</div>
          ${o.note ? `<div class="modal-row"><strong>Note:</strong>${escapeHtml(o.note)}</div>` : ""}
        </div>

        <div class="modal-section">
          <h3>Items</h3>
          <ul class="modal-items">${itemsHtml}</ul>
          <div class="modal-row" style="margin-top:0.5rem;text-align:right;font-family:'JetBrains Mono',monospace"><strong>Subtotal:</strong><span style="color:var(--chalk);font-weight:700;margin-left:0.5rem">${money(o.total)}</span></div>
          ${o.discount_percent > 0 ? `
          <div class="modal-row" style="text-align:right;font-family:'JetBrains Mono',monospace"><strong>Discount (${escapeHtml(o.discount_code)}):</strong><span style="color:var(--belgian-red);font-weight:700;margin-left:0.5rem">−${money(o.discount_amount)}</span></div>
          ` : ""}
          ${(o.loyalty_percent > 0) ? `
