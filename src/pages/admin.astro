      if (urlEl) urlEl.textContent = url;
      if (box) box.hidden = false;
      toast("Created " + code);
    }

    function focusCreateForm() {
      showTab("rewards");
      const card = document.getElementById("createCodeCard");
      card?.scrollIntoView({ behavior: "smooth", block: "start" });
      window.setTimeout(() => {
        (document.getElementById("newCode") as HTMLInputElement | null)?.focus();
      }, 150);
    }

    function generateCodeValue() {
      const name = (document.getElementById("newCodeName") as HTMLInputElement)?.value || "";
      if (name.trim()) return codeFromName(name);
      const suffix = Math.random().toString(36).slice(2, 6).toUpperCase().replace(/[^A-Z0-9]/g, "X");
      return `B420-${suffix}`;
    }

    async function submitNewCode(e: Event) {
      e.preventDefault();
      showAddCodeError("");
      const success = document.getElementById("addCodeSuccess") as HTMLElement | null;
      if (success) success.hidden = true;
      const code = normalizeReferralCode((document.getElementById("newCode") as HTMLInputElement).value);
      const owner_name = (document.getElementById("newCodeName") as HTMLInputElement).value.trim();
      const owner_email = (document.getElementById("newCodeEmail") as HTMLInputElement).value.trim();
      const note = (document.getElementById("newCodeNote") as HTMLInputElement).value.trim();
      if (!code) {
        showAddCodeError("Code needs at least 2 letters or numbers (A–Z, 0–9, dash, underscore).");
        return;
      }
      (document.getElementById("newCode") as HTMLInputElement).value = code;
      const submit = document.getElementById("addCodeSubmit") as HTMLButtonElement;
      submit.disabled = true;
      try {
        const result = await mutateRewards(
          { action: "upsert_code", code, owner_name, owner_email, note, active: true },
          (L) => {
            updateCodeMeta(L, { code, owner_name, owner_email, note, active: true });
          },
        );
        if (!result.ok) {
          showAddCodeError(result.error || "Could not save this code.");
          return;
        }
        if (result.local) {
          showAddCodeError(result.error || "Server did not confirm. Code is saved on this device — export JSON as backup.");
        }
        showCreateSuccess(code);
        (document.getElementById("addCodeForm") as HTMLFormElement).reset();
        (document.getElementById("newCode") as HTMLInputElement).value = code;
      } finally {
        submit.disabled = false;
      }
    }

    async function rewardsAction(code: string, act: string) {
      const row = findCode(code);
      if (act === "copy") {
        await copyShareLink(code);
        return;
      }
      if (act === "edit") {
        await openCodeEditor(row);
        return;
      }
      if (act === "adjust") {
        const result = await askDialog({
          title: `Adjust available credit`,
          body: `Current available for ${code}: ${money(row?.available)}. Enter a delta (25 or -25). Pending and redeemed do not change.`,
          okLabel: "Adjust",
          fields: [
            { name: "delta", label: "Amount (+ or −)", value: "25", required: true },
            { name: "note", label: "Why", placeholder: "Goodwill / correction" },
          ],
        });
        if (!result) return;
        const delta = parseFloat(result.delta);
        if (!Number.isFinite(delta)) return;
        const ok = await askDialog({
          title: "Confirm adjust",
          body: `${delta >= 0 ? "Add" : "Remove"} ${money(Math.abs(delta))} available credit on ${code}?`,
          okLabel: "Yes, adjust",
          danger: delta < 0,
        });
        if (!ok) return;
        await mutateRewards({ action: "adjust", code, delta, note: result.note }, (L) => adjustAvailable(L, { code, delta, note: result.note }));
        toast("Balance updated");
        return;
      }
      if (act === "clear") {
        const pending = money(row?.pending);
        const ok = await askDialog({
          title: "Mark paid / credit available?",
          body: `Move ${pending} pending on ${code} to available? Do this after the referred order is actually paid (or use Mark as Paid on the order card — that does the same thing).`,
          okLabel: "Make credit available",
        });
        if (!ok) return;
        await mutateRewards({ action: "clear_pending", code }, (L) => markCleared(L, { code }));
        toast("Credit is now available");
        return;
      }
      if (act === "redeem") {
        const result = await askDialog({
          title: "Mark redeemed",
          body: `${code} has ${money(row?.available)} available. Leave blank to redeem the full available balance (same as spending it at checkout).`,
          okLabel: "Mark redeemed",
          fields: [{ name: "amount", label: "Amount to redeem", placeholder: String(row?.available ?? ""), value: "" }],
        });
        if (!result) return;
        const amount = result.amount === "" ? undefined : parseFloat(result.amount);
        const ok = await askDialog({
          title: "Confirm redeem",
          body: `Mark ${amount == null ? "all available" : money(amount)} on ${code} as redeemed?`,
          okLabel: "Yes, mark redeemed",
        });
        if (!ok) return;
        await mutateRewards({ action: "mark_redeemed", code, amount }, (L) => {
          const r = L.codes[code];
          redeemCredit(L, { code, amount: amount ?? r?.available ?? 0 });
          return L;
        });
        toast("Marked redeemed");
        return;
      }
      if (act === "deactivate") {
        const ok = await askDialog({
          title: "Deactivate this code?",
          body: `Stop sharing ${code}. Existing pending and available credit stays. You can reactivate later.`,
          okLabel: "Deactivate",
          danger: true,
        });
        if (!ok) return;
        await mutateRewards({ action: "deactivate", code }, (L) => setCodeActive(L, { code, active: false }));
        toast(code + " deactivated");
        return;
      }
      if (act === "activate") {
        const ok = await askDialog({
          title: "Reactivate this code?",
          body: `${code} will show as active again so you can copy the share link.`,
          okLabel: "Reactivate",
        });
        if (!ok) return;
        await mutateRewards({ action: "activate", code }, (L) => setCodeActive(L, { code, active: true }));
        toast(code + " reactivated");
      }
    }

    async function mutateRewards(body: Record<string, unknown>, localFn: (L: ReturnType<typeof emptyLedger>) => unknown) {
      const res = await apiRewards(body);
      if (res.ok && res.data) {
        saveLocalLedger({
          version: 1,
          codes: Object.fromEntries((res.data.codes || []).map((c: any) => [c.code, c])),
          events: res.data.events || [],
          loyalty: res.data.loyalty || [],
          updated_at: res.data.updated_at,
        });
        rewardsSnap = res.data;
        usingLocal = false;
        const banner = document.getElementById("rewardsLocalBanner") as HTMLElement;
        if (banner) banner.hidden = true;
        renderRewards();
        renderOverview();
        return { ok: true, local: false, error: "" };
      }
      const L = loadLocalLedger();
      localFn(L);
      saveLocalLedger(L);
      usingLocal = true;
      rewardsSnap = {
        ok: true,
        codes: Object.values(L.codes),
        loyalty: L.loyalty,
        events: [...L.events].reverse().slice(0, 200),
        updated_at: L.updated_at,
      };
      const banner = document.getElementById("rewardsLocalBanner") as HTMLElement;
      if (banner) {
        banner.hidden = false;
        banner.textContent = `${res.error || "Rewards API unavailable."} Code was still saved on this device. Export JSON as backup.`;
      }
      renderRewards();
      renderOverview();
      return { ok: true, local: true, error: res.error || "Saved locally; server did not confirm." };
    }

    document.getElementById("rewardsRefresh")?.addEventListener("click", () => void loadRewards());
    document.getElementById("addCodeForm")?.addEventListener("submit", (e) => void submitNewCode(e));
    document.getElementById("generateCodeBtn")?.addEventListener("click", () => {
      const input = document.getElementById("newCode") as HTMLInputElement;
      input.value = generateCodeValue();
      input.focus();
    });
    document.getElementById("addCodeCopyBtn")?.addEventListener("click", () => {
      const url = document.getElementById("addCodeShareUrl")?.textContent || "";
      const code = normalizeReferralCode(url.split("ref=")[1] || (document.getElementById("newCode") as HTMLInputElement).value);
      void copyShareLink(code);
    });
    document.getElementById("overviewCreateBtn")?.addEventListener("click", () => focusCreateForm());
    document.getElementById("codeSearch")?.addEventListener("input", () => renderRewards());
    document.getElementById("codeFilter")?.addEventListener("change", () => renderRewards());
    document.getElementById("loySearch")?.addEventListener("input", () => renderRewards());
    document.getElementById("rewardsExport")?.addEventListener("click", () => {
      const payload = {
        exported_at: new Date().toISOString(),
        codes: rewardsSnap?.codes || [],
        loyalty: rewardsSnap?.loyalty || [],
        events: rewardsSnap?.events || [],
      };
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "belgium420-rewards.json";
      a.click();
    });
    document.getElementById("rewardsExportCsv")?.addEventListener("click", () => {
      const L = loadLocalLedger();
      const blob = new Blob([ledgerToCsv(L)], { type: "text/csv" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "belgium420-rewards.csv";
      a.click();
    });
    document.getElementById("rewardsImport")?.addEventListener("change", async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;
      const ok = await askDialog({
        title: "Import rewards JSON?",
        body: "This merges into the current ledger (higher balances win). Export a backup first if you are unsure.",
        okLabel: "Import",
      });
      if (!ok) return;
      try {
        const incoming = JSON.parse(await file.text());
        const ledger = incoming.codes && !incoming.ledger
          ? {
              version: 1,
              codes: Array.isArray(incoming.codes)
                ? Object.fromEntries(incoming.codes.map((c: any) => [c.code, c]))
                : incoming.codes,
              events: incoming.events || [],
              loyalty: incoming.loyalty || [],
            }
          : incoming.ledger || incoming;
        const merged = mergeLedgers(loadLocalLedger(), ledger);
        saveLocalLedger(merged);
        const snapRes = await apiRewards({ action: "import", ledger: merged });
        if (snapRes.ok && snapRes.data) {
          rewardsSnap = snapRes.data;
          usingLocal = false;
        } else {
          usingLocal = true;
          rewardsSnap = {
            ok: true,
            codes: Object.values(merged.codes),
            loyalty: merged.loyalty,
            events: merged.events,
            updated_at: merged.updated_at,
          };
        }
        const banner = document.getElementById("rewardsLocalBanner") as HTMLElement;
        if (banner) banner.hidden = !usingLocal;
        renderRewards();
        renderOverview();
        toast("Imported ledger");
      } catch {
        alert("Could not import that file.");
      }
    });

    if (getKey()) showKanban();
    else showLogin();
  </script>
</body>
</html>
