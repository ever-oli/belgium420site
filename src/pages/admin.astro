      const evt = document.getElementById("evtList")!;
      evt.innerHTML = events.length
        ? events.slice(0, 40).map((e: any) => `<div>${escapeHtml(relTime(e.at || ""))} · <strong>${escapeHtml(e.type)}</strong> · ${escapeHtml(e.code)} · ${money(e.amount)} · ${escapeHtml(e.order_id || "")} ${escapeHtml(e.note || "")}</div>`).join("")
        : `<div class="empty">No events yet. Create a code or wait for a referred checkout.</div>`;
    }

