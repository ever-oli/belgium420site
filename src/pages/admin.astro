    async function openCodeEditor(existing?: any) {
      const isNew = !existing;
      const result = await askDialog({
        title: isNew ? "New referral code" : `Edit ${existing.code}`,
        body: isNew
          ? "Give this to one person. They share https://belgium420.com/?ref=CODE with friends."
          : "Update owner details. The code itself does not change.",
        okLabel: isNew ? "Create code" : "Save",
        fields: [
          ...(isNew ? [{ name: "code", label: "Code", value: "", placeholder: "ALICE", required: true }] : []),
          { name: "owner_name", label: "Owner name", value: existing?.owner_name || "", placeholder: "Alice" },
          { name: "owner_email", label: "Owner email", value: existing?.owner_email || "", type: "email", placeholder: "alice@email.com" },
          { name: "note", label: "Notes", value: existing?.note || "", placeholder: "Instagram / wholesale / VIP" },
        ],
      });
      if (!result) return;
      const code = isNew ? result.code : existing.code;
      await mutateRewards(
        { action: "upsert_code", code, owner_name: result.owner_name, owner_email: result.owner_email, note: result.note, active: existing?.active !== false },
        (L) => {
          updateCodeMeta(L, {
            code,
            owner_name: result.owner_name,
            owner_email: result.owner_email,
            note: result.note,
            active: existing?.active !== false,
          });
        },
      );
      toast(isNew ? "Code saved" : "Updated " + code);
      if (isNew) showCreateSuccess(code);
    }

