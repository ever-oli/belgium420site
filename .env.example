# Browser-facing domains. In local dev Astro proxies /auth and /api to PORT.
WEBSITE_DOMAIN=http://localhost:4321
API_DOMAIN=http://localhost:4321
PORT=3001

# Production (Express serves static + auth on one origin):
# WEBSITE_DOMAIN=https://belgium420.com
# API_DOMAIN=https://belgium420.com

# SuperTokens Core — demo URI for local tryout only.
SUPERTOKENS_CONNECTION_URI=https://try.supertokens.com
# SUPERTOKENS_API_KEY=

# Friends & family invite required on signup
INVITE_CODE=belgium420-ff

# --- Auth toggle ---
# Set to "true" to re-enable the SuperTokens login gate (auth UI + script + nav logout).
# When unset or any other value, the site is fully public (no login, no invite, no logout).
# AUTH_ENABLED=true

