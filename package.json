{
  "name": "belgium420",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n astro,auth -c yellow,cyan \"astro dev --port 4321\" \"node --env-file=.env server/index.mjs\"",
    "dev:site": "astro dev --port 4321",
    "auth": "node --env-file=.env server/index.mjs",
    "build": "node scripts/optimize-inventory.mjs && astro build",
    "preview": "astro preview",
    "start": "node --env-file=.env server/index.mjs",
    "test": "node --test tests/*.test.js tests/*.test.mjs"
  },
  "dependencies": {
    "astro": "^4.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "4.21.2",
    "supertokens-node": "^21.1.2",
    "supertokens-web-js": "^0.15.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^5.0.0",
    "concurrently": "^9.1.2",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "sharp@0.35.5": true,
    "esbuild@0.21.5": true,
    "browser-tabs-lock@1.3.0": true
  }
}
