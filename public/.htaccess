# Belgium420 — pretty URL fallbacks for Hostinger Apache
RewriteEngine On

# Old file-format URLs → directory routes
RewriteRule ^checkout\.html$ /checkout/ [R=301,L]
RewriteRule ^admin\.html$ /admin/ [R=301,L]

# Serve directory index without forcing a trailing slash when the folder exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ /$1/index.html [L]
